---
import type { Lang } from '@ferme/core';
import { brand, seedCategories } from '@ferme/core';
import { t, L } from '@/i18n';
import { asset, href, routes, telLink, whatsappLink } from '@/lib/paths';
import Logo from '@/components/Logo.astro';
import Art from '@/components/Art.astro';
import TornEdge from '@/components/deco/TornEdge.astro';
import NewsletterForm from '@/components/islands/NewsletterForm';

/**
 * Le pied de page, d'après la maquette du client : cinq colonnes séparées par
 * des filets qui prennent toute la largeur de l'écran (marque et piliers,
 * boutique, informations, contact, lettre d'information), un rameau d'olivier
 * en haut à droite, des collines en filigrane qui se fondent derrière la
 * pancarte « Direct de la ferme » à gauche et le nid d'œufs à droite, puis une
 * barre vert profond à bord ondulé, avec les valeurs et le retour en haut.
 *
 * Tout le bas doit se lire comme une seule image : les collines sont posées
 * entières (jamais rognées), centrées, et s'estompent vers le haut et sur les
 * côtés ; la vague verte mord dessus, et la pancarte comme le nid passent
 * par-dessus la vague.
 */
interface Props {
  lang: Lang;
  slim?: boolean;
}
const { lang, slim = false } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const cats = [...seedCategories].sort((a, b) => a.sort - b.sort);
const info = [
  { label: d.nav.farm, to: routes.farm },
  { label: d.nav.quality, to: routes.quality },
  { label: d.nav.recipes, to: routes.recipes },
  { label: d.nav.track, to: routes.tracking },
  { label: d.nav.account, to: routes.account },
  { label: d.footer.terms, to: routes.terms },
  { label: d.footer.privacy, to: routes.privacy },
  { label: d.footer.legal, to: routes.legal },
];
const pillarIcons = [
  'M12 21s-7-4.6-7-10.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 2.5C19 16.4 12 21 12 21Z',
  'M12 3 5 6v5c0 5 3 8.5 7 10 4-1.5 7-5 7-10V6l-7-3ZM9 12l2 2 4-4',
  'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 18a2 2 0 1 0 0 .01M17 18a2 2 0 1 0 0 .01',
  'M12 21s-7-4.6-7-10.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 2.5C19 16.4 12 21 12 21Z',
];
const head = 'flex items-center gap-3 text-[13px] font-extrabold uppercase tracking-[0.12em] text-ink';
const headIcon = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-prairie-soft text-prairie-deep';
const link = 'block py-1.5 text-[15px] leading-snug text-ink-2 transition-colors hover:text-prairie-deep xl:text-base';
const social = 'flex h-12 w-12 items-center justify-center rounded-pill bg-paper text-ink shadow-card transition-colors hover:text-prairie-deep';
---

<footer class="relative overflow-hidden bg-cream">
  {
    !slim && (
      <div class="relative">
        <Art name="footer-olivier-brin" class="deco -end-4 top-3 w-44 rtl:-scale-x-100 sm:w-52 lg:-end-6 lg:top-5 lg:w-64 xl:w-72" width={288} height={100} sizes="288px" />

        <div class="footer-wrap relative mx-auto w-full max-w-[1880px] px-5 pt-20 sm:px-8 lg:px-10 lg:pt-28 xl:px-12">
          <div class="grid gap-10 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,0.9fr)_minmax(0,0.9fr)_minmax(0,1.25fr)_minmax(0,1.05fr)] lg:gap-0">
            <div class="footer-col flex min-w-0 flex-col gap-6 sm:col-span-2 lg:col-span-1 lg:pe-5 xl:pe-8">
              <div class="flex items-center gap-3 lg:gap-2 xl:gap-4">
                <Logo class="h-24 w-24 shrink-0 sm:h-28 sm:w-28 lg:h-24 lg:w-24 2xl:h-32 2xl:w-32" size={128} />
                <div class="min-w-0">
                  <a href={href(lang)} class="block font-display text-4xl font-extrabold leading-none text-ink sm:text-[2.75rem] lg:text-4xl xl:whitespace-nowrap 2xl:text-[2.75rem]">{brand.name[lang]}</a>
                  {lang === 'fr' ? (
                    <Art name="footer-gout-local" alt={d.footer.taglineAlt} class="mt-2 w-52 sm:w-60 lg:w-44 xl:w-48 2xl:w-64" width={288} height={60} sizes="(min-width: 1536px) 288px, 240px" />
                  ) : (
                    <p class="mt-2 font-display text-2xl font-bold text-paprika">{d.footer.taglineAlt}</p>
                  )}
                </div>
              </div>
              <p class="max-w-md text-lg leading-snug text-ink xl:text-xl">{d.footer.tagline}</p>
              <ul class="grid max-w-md grid-cols-4 gap-2 text-center">
                {d.footer.pillars.map((p, i) => (
                  <li class="flex flex-col items-center gap-2">
                    <span class="flex h-16 w-16 items-center justify-center rounded-pill bg-prairie-soft text-prairie" aria-hidden="true">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={pillarIcons[i]} /></svg>
                    </span>
                    <span class="text-[13px] font-semibold leading-tight text-ink-2 xl:text-sm">
                      {p.title}
                      <span class="block">{p.text}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="footer-col min-w-0 lg:px-5 xl:px-8">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16l-1.5 12.5a1 1 0 0 1-1 .9h-11a1 1 0 0 1-1-.9z" /><path d="M8 7a4 4 0 0 1 8 0" /></svg></span>
                {d.footer.shop}
              </h3>
              <ul class="mt-5 flex flex-col gap-1">
                {cats.map((c) => (
                  <li><a href={href(lang, routes.category(c.slug))} class={link}>{L(c.name, lang)}</a></li>
                ))}
                <li class="mt-1">
                  <a href={href(lang, routes.shop)} class="inline-flex items-center gap-1.5 py-1.5 text-[15px] font-bold text-prairie-deep hover:text-prairie xl:text-base">
                    {d.common.seeAll}
                    <svg class="rtl:-scale-x-100" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </a>
                </li>
              </ul>
            </div>

            <div class="footer-col min-w-0 lg:px-5 xl:px-8">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg></span>
                {d.footer.info}
              </h3>
              <ul class="mt-5 flex flex-col gap-1">
                {info.map((i) => (
                  <li><a href={href(lang, i.to)} class={link}>{i.label}</a></li>
                ))}
              </ul>
            </div>

            <div class="footer-col min-w-0 lg:px-5 xl:px-8">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 1 16 0" /><rect x="3" y="13" width="4" height="6" rx="1.5" /><rect x="17" y="13" width="4" height="6" rx="1.5" /><path d="M19 19a3 3 0 0 1-3 3h-2" /></svg></span>
                {d.footer.contact}
              </h3>
              <div class="mt-5 flex items-start gap-3">
                <svg class="mt-1 shrink-0 text-ink" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <div>
                  <a href={telLink(brand.phone)} class="font-display text-[1.75rem] font-extrabold leading-none text-ink hover:text-prairie-deep">{brand.phoneDisplay}</a>
                  <p class="mt-2 text-[15px] leading-snug text-ink-2">{brand.hours[lang]}</p>
                </div>
              </div>
              <a href={whatsappLink(brand.whatsapp)} class="btn btn-sm mt-5 w-full gap-2 whitespace-nowrap bg-prairie-deep px-3 text-[13px] text-paper hover:bg-prairie xl:text-sm 2xl:text-[15px]" rel="noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8.9-.3.2-.5 0a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.8c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.7 11.5 11.5 0 0 0 4.4 3.9c1.6.7 2.3.7 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.2-.2-.2-.4-.3Z" /></svg>
                {d.footer.whatsappCta}
                <svg class="hidden rtl:-scale-x-100 xl:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <p class="mt-5 flex items-start gap-3 text-[15px] leading-snug text-ink">
                <svg class="mt-0.5 shrink-0 text-prairie-deep" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-7.1 7-12a7 7 0 0 0-14 0c0 4.9 7 12 7 12Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                {brand.address[lang]}
              </p>
              <div class="mt-5 flex gap-3">
                {brand.social.facebook && (
                  <a href={brand.social.facebook} class={social} aria-label="Facebook" rel="noopener" target="_blank">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3Z" /></svg>
                  </a>
                )}
                {brand.social.instagram && (
                  <a href={brand.social.instagram} class={social} aria-label="Instagram" rel="noopener" target="_blank">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
                  </a>
                )}
                <a href={brand.social.youtube || 'https://youtube.com/'} class={social} aria-label="YouTube" rel="noopener" target="_blank">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z" /></svg>
                </a>
              </div>
            </div>

            <div class="footer-col min-w-0 lg:ps-5 xl:ps-8">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></span>
                {d.footer.newsletter}
              </h3>
              <p class="mt-5 text-[15px] leading-snug text-ink xl:text-base">{d.footer.newsletterText}</p>
              <div class="mt-5"><NewsletterForm client:visible lang={lang} /></div>
              {lang === 'fr' ? (
                <Art name="footer-oeufs-heureux" alt={d.footer.happyEggsAlt} class="mt-2 w-full max-w-[16rem] -rotate-3" width={256} height={97} sizes="256px" />
              ) : (
                <p class="mt-3 font-display text-xl font-bold text-ink">{d.footer.happyEggsAlt}</p>
              )}
            </div>
          </div>
        </div>

        <!-- Le paysage en filigrane : un panorama posé au ras de la vague, jamais rogné en haut, estompé vers le haut. -->
        <div class="footer-hills pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true">
          <picture class="block h-full w-full">
            <source type="image/avif" srcset={`${asset('/images/art/footer-collines-pano-1600.avif')} 1600w, ${asset('/images/art/footer-collines-pano-3200.avif')} 3200w, ${asset('/images/art/footer-collines-pano-4800.avif')} 4800w`} sizes="(min-width: 1024px) 160vw, 300vw" />
            <source type="image/webp" srcset={`${asset('/images/art/footer-collines-pano-1600.webp')} 1600w, ${asset('/images/art/footer-collines-pano-3200.webp')} 3200w, ${asset('/images/art/footer-collines-pano-4800.webp')} 4800w`} sizes="(min-width: 1024px) 160vw, 300vw" />
            <img src={asset('/images/art/footer-collines-pano.png')} alt="" width={3200} height={178} loading="lazy" decoding="async" class="block h-full w-full object-cover object-bottom" />
          </picture>
        </div>

        <!-- La vague verte mord sur le paysage. -->
        <TornEdge variant="wave" position="bottom" class="text-prairie-deep" height={24} />

        <!-- La pancarte et le nid passent par-dessus la vague. -->
        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20" aria-hidden="true">
          <Art name="footer-gauche" alt={d.footer.signAlt} class="absolute -start-2 bottom-[-0.35rem] w-[clamp(8.5rem,12vw,15rem)]" sizes="240px" />
          <Art name="footer-droite" class="absolute -end-3 bottom-[-0.5rem] w-[clamp(9.5rem,16vw,20rem)]" sizes="320px" />
        </div>
      </div>
    )
  }

  <div class="relative bg-prairie-deep text-paper/85">
    <div class="mx-auto flex w-full max-w-[1880px] flex-col items-center gap-3 px-5 py-5 text-[15px] sm:px-8 lg:flex-row lg:justify-between lg:px-10 xl:px-12">
      <p>{d.footer.rights(year)}</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-paper">
        <li class="flex items-center gap-2.5">
          <span class="flag-tn" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="12" fill="#e70013" />
              <circle cx="12" cy="12" r="7.2" fill="#fff" />
              <circle cx="12" cy="12" r="5.4" fill="#e70013" />
              <circle cx="13.5" cy="12" r="4.4" fill="#fff" />
              <polygon points="13.60,9.10 14.28,11.07 16.36,11.10 14.69,12.36 15.30,14.35 13.60,13.15 11.90,14.35 12.51,12.36 10.84,11.10 12.92,11.07" fill="#e70013" />
            </svg>
          </span>
          {d.footer.values[0]}
        </li>
        {d.footer.values.slice(1).map((v, i) => (
          <li class="flex items-center gap-3">
            <span class="text-paper/40" aria-hidden="true">|</span>
            <span class="flex items-center gap-1.5">
              {v}
              {i === d.footer.values.length - 2 && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.6-7-10.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 2.5C19 16.4 12 21 12 21Z" /></svg>
              )}
            </span>
          </li>
        ))}
      </ul>
      <p class="lg:pe-20">
        {d.footer.made} <a href="https://capmedia.tn" class="font-semibold text-paper hover:underline" rel="noopener" target="_blank">Capmedia Digital</a>
      </p>
    </div>
    <a href="#contenu" class="footer-top absolute bottom-4 end-5 flex h-14 w-14 items-center justify-center rounded-pill border-2 border-paper/70 bg-prairie-deep text-paper transition-colors hover:bg-prairie lg:bottom-1/2 lg:end-8 lg:translate-y-1/2 xl:end-10" aria-label={d.common.backToTop} data-footer-top>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </a>
  </div>
</footer>

<script>
  // Le rond « retour en haut » remonte en douceur, ou d'un coup si l'utilisateur réduit les animations.
  function armFooterTop() {
    document.querySelectorAll<HTMLAnchorElement>('[data-footer-top]').forEach((a) => {
      if (a.dataset.ready) return;
      a.dataset.ready = '1';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
  }
  armFooterTop();
  document.addEventListener('astro:page-load', armFooterTop);
</script>

<style>
  /* Une seule mesure pour le paysage et pour la place qu'on lui laisse sous les colonnes. */
  footer {
    --hills-h: clamp(5rem, 24vw, 7rem);
  }
  @media (min-width: 640px) {
    footer {
      --hills-h: clamp(6rem, 12vw, 9rem);
    }
  }
  @media (min-width: 1024px) {
    footer {
      --hills-h: clamp(7rem, 9vw, 12rem);
    }
    /* Filets entre les colonnes, sur ordinateur seulement. */
    .footer-col + .footer-col {
      border-inline-start: 1px solid var(--color-line-2);
    }
  }
  .footer-wrap {
    padding-bottom: calc(var(--hills-h) + 1.5rem);
  }
  /* Le paysage couvre en largeur et s'estompe vers le haut. */
  .footer-hills {
    height: var(--hills-h);
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%);
    mask-image: linear-gradient(to bottom, transparent, #000 45%);
  }
  .flag-tn {
    display: inline-flex;
    line-height: 0;
  }
</style>
