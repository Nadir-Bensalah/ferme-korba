---
import type { Lang } from '@ferme/core';
import { brand, seedCategories } from '@ferme/core';
import { t, L } from '@/i18n';
import { href, routes, telLink, whatsappLink } from '@/lib/paths';
import Logo from '@/components/Logo.astro';

interface Props {
  lang: Lang;
  slim?: boolean;
}
const { lang, slim = false } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line bg-cream">
  {
    !slim && (
      <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
        <div class="flex flex-col gap-4">
          <a href={href(lang)} class="flex items-center gap-2.5">
            <Logo class="h-10 w-10" />
            <span class="font-display text-xl font-extrabold">{brand.name[lang]}</span>
          </a>
          <p class="text-ink-2">{d.footer.tagline}</p>
          <p class="text-sm text-ink-3">{brand.address[lang]}</p>
          <p class="text-sm text-ink-3">{brand.hours[lang]}</p>
        </div>
        <div>
          <h3 class="eyebrow mb-4">{d.footer.shop}</h3>
          <ul class="flex flex-col gap-2.5">
            {seedCategories.map((c) => (
              <li>
                <a href={href(lang, routes.category(c.slug))} class="text-ink-2 hover:text-ink">
                  {L(c.name, lang)}
                </a>
              </li>
            ))}
            <li>
              <a href={href(lang, routes.shop)} class="font-semibold text-prairie hover:text-prairie-deep">
                {d.common.seeAll}
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="eyebrow mb-4">{d.footer.info}</h3>
          <ul class="flex flex-col gap-2.5">
            <li><a href={href(lang, routes.farm)} class="text-ink-2 hover:text-ink">{d.nav.farm}</a></li>
            <li><a href={href(lang, routes.quality)} class="text-ink-2 hover:text-ink">{d.nav.quality}</a></li>
            <li><a href={href(lang, routes.recipes)} class="text-ink-2 hover:text-ink">{d.nav.recipes}</a></li>
            <li><a href={href(lang, routes.tracking)} class="text-ink-2 hover:text-ink">{d.nav.track}</a></li>
            <li><a href={href(lang, routes.account)} class="text-ink-2 hover:text-ink">{d.nav.account}</a></li>
            <li><a href={href(lang, routes.terms)} class="text-ink-2 hover:text-ink">{d.footer.terms}</a></li>
            <li><a href={href(lang, routes.privacy)} class="text-ink-2 hover:text-ink">{d.footer.privacy}</a></li>
            <li><a href={href(lang, routes.legal)} class="text-ink-2 hover:text-ink">{d.footer.legal}</a></li>
          </ul>
        </div>
        <div class="flex flex-col gap-3">
          <h3 class="eyebrow">{d.footer.contact}</h3>
          <a href={telLink(brand.phone)} class="btn-ghost justify-start bg-paper">
            <span aria-hidden="true">📞</span> {brand.phoneDisplay}
          </a>
          <a href={whatsappLink(brand.whatsapp)} class="btn-soft justify-start" rel="noopener" target="_blank">
            <span aria-hidden="true">💬</span> {d.common.whatsapp}
          </a>
          <p class="mt-2 text-sm text-ink-3">{d.footer.cod}</p>
          <div class="mt-2 flex gap-3">
            {brand.social.facebook && (
              <a href={brand.social.facebook} class="rounded-pill bg-paper p-2.5 text-ink-2 shadow-card hover:text-ink" aria-label="Facebook" rel="noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3Z" /></svg>
              </a>
            )}
            {brand.social.instagram && (
              <a href={brand.social.instagram} class="rounded-pill bg-paper p-2.5 text-ink-2 shadow-card hover:text-ink" aria-label="Instagram" rel="noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    )
  }
  <div class="border-t border-line/70">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-5 text-xs text-ink-3 sm:flex-row">
      <p>{d.footer.rights(year)}</p>
      <p>
        {d.footer.made} <a href="https://capmedia.tn" class="font-semibold text-ink-2 hover:text-ink" rel="noopener" target="_blank">Capmedia Digital</a>
      </p>
    </div>
  </div>
</footer>
