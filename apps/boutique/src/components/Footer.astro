---
import type { Lang } from '@ferme/core';
import { brand, seedCategories } from '@ferme/core';
import { t, L } from '@/i18n';
import { href, routes, telLink, whatsappLink } from '@/lib/paths';
import Logo from '@/components/Logo.astro';
import Art from '@/components/Art.astro';
import NewsletterForm from '@/components/islands/NewsletterForm';

/**
 * Le pied de page, d'après la maquette du client : cinq colonnes séparées par
 * des filets (marque et piliers, boutique, informations, contact, lettre
 * d'information), un rameau d'olivier en haut à droite, une bande de collines
 * en fond, la pancarte « Direct de la ferme » à gauche et le nid d'œufs à
 * droite, puis une barre vert profond avec les valeurs et le retour en haut.
 */
interface Props {
  lang: Lang;
  slim?: boolean;
}
const { lang, slim = false } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const cats = [...seedCategories].sort((a, b) => a.sort - b.sort);
const info = [
  { label: d.nav.farm, to: routes.farm },
  { label: d.nav.quality, to: routes.quality },
  { label: d.nav.recipes, to: routes.recipes },
  { label: d.nav.track, to: routes.tracking },
  { label: d.nav.account, to: routes.account },
  { label: d.footer.terms, to: routes.terms },
  { label: d.footer.privacy, to: routes.privacy },
  { label: d.footer.legal, to: routes.legal },
];
const pillarIcons = [
  'M12 21s-7-4.6-7-10.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 2.5C19 16.4 12 21 12 21Z',
  'M12 3 5 6v5c0 5 3 8.5 7 10 4-1.5 7-5 7-10V6l-7-3ZM9 12l2 2 4-4',
  'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 18a2 2 0 1 0 0 .01M17 18a2 2 0 1 0 0 .01',
  'M12 21s-7-4.6-7-10.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 2.5C19 16.4 12 21 12 21Z',
];
const head = 'flex items-center gap-3 text-[13px] font-extrabold uppercase tracking-[0.12em] text-ink';
const headIcon = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-prairie-soft text-prairie-deep';
const link = 'block py-1 text-[15px] text-ink-2 transition-colors hover:text-prairie-deep';
---

<footer class="relative bg-cream">
  {
    !slim && (
      <div class="relative overflow-hidden">
        <Art name="footer-olivier" class="deco -end-6 -top-4 w-40 sm:w-56 lg:-end-4 lg:w-64" sizes="256px" />

        <div class="container-x relative pt-14 pb-40 sm:pb-44 lg:pb-52">
          <div class="footer-grid grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.9fr)_minmax(0,1fr)_minmax(0,1.2fr)_minmax(0,1.2fr)] lg:gap-0">
            <div class="footer-col flex min-w-0 flex-col gap-5 lg:pe-6">
              <div class="flex items-start gap-3">
                <Logo class="h-20 w-20 shrink-0 sm:h-24 sm:w-24 lg:h-20 lg:w-20 xl:h-24 xl:w-24" size={96} />
                <div class="min-w-0">
                  <a href={href(lang)} class="block font-display text-3xl font-extrabold leading-none text-ink sm:text-4xl lg:text-[1.9rem] xl:text-4xl">{brand.name[lang]}</a>
                  {lang === 'fr' ? (
                    <Art name="footer-gout-local" alt={d.footer.taglineAlt} class="mt-2 w-44 sm:w-52 lg:w-36 xl:w-48" width={208} height={44} sizes="208px" />
                  ) : (
                    <p class="mt-2 font-display text-xl font-bold text-paprika">{d.footer.taglineAlt}</p>
                  )}
                </div>
              </div>
              <p class="text-[17px] leading-snug text-ink">{d.footer.tagline}</p>
              <ul class="grid grid-cols-4 gap-2 text-center">
                {d.footer.pillars.map((p, i) => (
                  <li class="flex flex-col items-center gap-2">
                    <span class="flex h-14 w-14 items-center justify-center rounded-pill bg-prairie-soft text-prairie" aria-hidden="true">
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={pillarIcons[i]} /></svg>
                    </span>
                    <span class="text-[13px] font-semibold leading-tight text-ink-2">
                      {p.title}
                      <span class="block">{p.text}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="footer-col min-w-0 lg:px-6">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16l-1.5 12.5a1 1 0 0 1-1 .9h-11a1 1 0 0 1-1-.9z" /><path d="M8 7a4 4 0 0 1 8 0" /></svg></span>
                {d.footer.shop}
              </h3>
              <ul class="mt-4 flex flex-col gap-1">
                {cats.map((c) => (
                  <li><a href={href(lang, routes.category(c.slug))} class={link}>{L(c.name, lang)}</a></li>
                ))}
                <li class="mt-1">
                  <a href={href(lang, routes.shop)} class="inline-flex items-center gap-1.5 py-1 text-[15px] font-bold text-prairie-deep hover:text-prairie">
                    {d.common.seeAll}
                    <svg class="rtl:-scale-x-100" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </a>
                </li>
              </ul>
            </div>

            <div class="footer-col min-w-0 lg:px-6">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg></span>
                {d.footer.info}
              </h3>
              <ul class="mt-4 flex flex-col gap-1">
                {info.map((i) => (
                  <li><a href={href(lang, i.to)} class={link}>{i.label}</a></li>
                ))}
              </ul>
            </div>

            <div class="footer-col min-w-0 lg:px-6">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13a8 8 0 0 1 16 0" /><rect x="3" y="13" width="4" height="6" rx="1.5" /><rect x="17" y="13" width="4" height="6" rx="1.5" /><path d="M19 19a3 3 0 0 1-3 3h-2" /></svg></span>
                {d.footer.contact}
              </h3>
              <div class="mt-4 flex items-start gap-3">
                <svg class="mt-1 shrink-0 text-ink" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <div>
                  <a href={telLink(brand.phone)} class="font-display text-2xl font-extrabold leading-none text-ink hover:text-prairie-deep">{brand.phoneDisplay}</a>
                  <p class="mt-1.5 text-sm leading-snug text-ink-2">{brand.hours[lang]}</p>
                </div>
              </div>
              <a href={whatsappLink(brand.whatsapp)} class="btn btn-sm mt-4 w-full gap-2 whitespace-nowrap bg-[#25a55b] px-3 text-[13px] text-paper hover:bg-prairie-deep xl:text-sm" rel="noopener" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8.9-.3.2-.5 0a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.8c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.7 11.5 11.5 0 0 0 4.4 3.9c1.6.7 2.3.7 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.2-.2-.2-.4-.3Z" /></svg>
                {d.footer.whatsappCta}
                <svg class="rtl:-scale-x-100" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
              <p class="mt-4 flex items-start gap-3 text-sm leading-snug text-ink">
                <svg class="mt-0.5 shrink-0 text-prairie-deep" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-7.1 7-12a7 7 0 0 0-14 0c0 4.9 7 12 7 12Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                {brand.address[lang]}
              </p>
              <div class="mt-4 flex gap-3">
                {brand.social.facebook && (
                  <a href={brand.social.facebook} class="flex h-12 w-12 items-center justify-center rounded-pill bg-paper text-ink shadow-card hover:text-prairie-deep" aria-label="Facebook" rel="noopener" target="_blank">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.4V14h2.8v8h3.3Z" /></svg>
                  </a>
                )}
                {brand.social.instagram && (
                  <a href={brand.social.instagram} class="flex h-12 w-12 items-center justify-center rounded-pill bg-paper text-ink shadow-card hover:text-prairie-deep" aria-label="Instagram" rel="noopener" target="_blank">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
                  </a>
                )}
                <a href={brand.social.youtube || 'https://youtube.com/'} class="flex h-12 w-12 items-center justify-center rounded-pill bg-paper text-ink shadow-card hover:text-prairie-deep" aria-label="YouTube" rel="noopener" target="_blank">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z" /></svg>
                </a>
              </div>
            </div>

            <div class="footer-col min-w-0 lg:ps-6">
              <h3 class={head}>
                <span class={headIcon} aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></span>
                {d.footer.newsletter}
              </h3>
              <p class="mt-4 text-[15px] leading-snug text-ink">{d.footer.newsletterText}</p>
              <div class="mt-4"><NewsletterForm client:visible lang={lang} /></div>
              {lang === 'fr' ? (
                <Art name="footer-oeufs-heureux" alt={d.footer.happyEggsAlt} class="mt-3 w-56 -rotate-3" width={224} height={85} sizes="224px" />
              ) : (
                <p class="mt-3 font-display text-lg font-bold text-ink">{d.footer.happyEggsAlt}</p>
              )}
            </div>
          </div>
        </div>

        <!-- Les collines en fond, la pancarte à gauche, le nid à droite. -->
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 sm:h-44 lg:h-52" aria-hidden="true">
          <Art name="footer-collines" class="absolute inset-x-0 bottom-0 h-full w-full opacity-70 [&_img]:object-cover [&_img]:object-bottom" sizes="100vw" />
          <Art name="footer-gauche" alt={d.footer.signAlt} class="absolute -bottom-2 -start-3 w-44 sm:w-56 lg:w-64" sizes="256px" />
          <Art name="footer-droite" class="absolute -bottom-3 -end-4 w-44 sm:w-56 lg:w-72" sizes="288px" />
        </div>
      </div>
    )
  }

  <div class="relative bg-prairie-deep text-paper/85">
    <div class="container-x flex flex-col items-center gap-3 py-5 text-sm lg:flex-row lg:justify-between">
      <p>{d.footer.rights(year)}</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-paper">
        <li class="flex items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-pill bg-[#e70013]" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M13.5 6a6 6 0 1 0 0 12 5 5 0 1 1 0-12Zm2.7 3.4 1.1 2.1 2.3.3-1.7 1.6.4 2.3-2.1-1.1-2.1 1.1.4-2.3-1.7-1.6 2.3-.3 1.1-2.1Z" /></svg>
          </span>
          {d.footer.values[0]}
        </li>
        {d.footer.values.slice(1).map((v, i) => (
          <li class="flex items-center gap-3">
            <span class="text-paper/40" aria-hidden="true">|</span>
            <span class="flex items-center gap-1.5">
              {v}
              {i === d.footer.values.length - 2 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.6-7-10.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 2.5C19 16.4 12 21 12 21Z" /></svg>
              )}
            </span>
          </li>
        ))}
      </ul>
      <p class="lg:pe-16">
        {d.footer.made} <a href="https://capmedia.tn" class="font-semibold text-paper hover:underline" rel="noopener" target="_blank">Capmedia Digital</a>
      </p>
    </div>
    <a href="#contenu" class="footer-top absolute bottom-4 end-4 flex h-12 w-12 items-center justify-center rounded-pill border-2 border-paper/70 bg-prairie-deep text-paper transition-colors hover:bg-prairie lg:bottom-1/2 lg:translate-y-1/2" aria-label={d.common.backToTop} data-footer-top>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </a>
  </div>
</footer>

<script>
  // Le rond « retour en haut » remonte en douceur, ou d'un coup si l'utilisateur réduit les animations.
  function armFooterTop() {
    document.querySelectorAll<HTMLAnchorElement>('[data-footer-top]').forEach((a) => {
      if (a.dataset.ready) return;
      a.dataset.ready = '1';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
  }
  armFooterTop();
  document.addEventListener('astro:page-load', armFooterTop);
</script>

<style>
  /* Filets entre les colonnes, sur ordinateur seulement. */
  @media (min-width: 1024px) {
    .footer-col + .footer-col {
      border-inline-start: 1px solid var(--color-line-2);
    }
  }
</style>
