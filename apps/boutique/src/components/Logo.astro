---
import { asset } from '@/lib/paths';

/**
 * Le logo de la ferme : poule, coq, poussins et œufs dans un cercle de feuilles.
 * Fichier source : assets/logo.png, décliné par `node scripts/logo.mjs`.
 */
interface Props {
  class?: string;
  /** Taille de rendu en pixels, pour choisir la bonne déclinaison. */
  size?: number;
}
const { class: cls = 'h-10 w-10', size = 40 } = Astro.props;
const px = size <= 48 ? 96 : size <= 96 ? 192 : size <= 128 ? 256 : 512;
---

<picture class:list={['block shrink-0', cls]}>
  <source type="image/webp" srcset={`${asset(`/logo-${px}.webp`)} 1x, ${asset(`/logo-${Math.min(512, px * 2)}.webp`)} 2x`} />
  <img src={asset(`/logo-${px}.png`)} srcset={`${asset(`/logo-${Math.min(512, px * 2)}.png`)} 2x`} alt="" width={size} height={size} class="h-full w-full object-contain" decoding="async" />
</picture>
