---
/**
 * Titre de section : surtitre vert, titre display, texte gris, lien optionnel à droite.
 */
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  link?: { href: string; label: string };
  align?: 'start' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}
const { eyebrow, title, text, link, align = 'start', as: Tag = 'h2', class: cls = '' } = Astro.props;
---

<div class:list={['reveal flex flex-col gap-3', align === 'center' ? 'items-center text-center' : 'sm:flex-row sm:items-end sm:justify-between', cls]}>
  <div class:list={['max-w-2xl', align === 'center' && 'mx-auto']}>
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <Tag class:list={['font-extrabold leading-[1.05]', Tag === 'h1' ? 'text-4xl sm:text-5xl lg:text-6xl' : 'text-3xl sm:text-4xl']}>{title}</Tag>
    {text && <p class="mt-3 text-lg text-ink-2">{text}</p>}
  </div>
  {link && (
    <a href={link.href} class="group inline-flex shrink-0 items-center gap-1.5 font-bold text-prairie hover:text-prairie-deep">
      {link.label}
      <svg class="transition-transform group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  )}
</div>
