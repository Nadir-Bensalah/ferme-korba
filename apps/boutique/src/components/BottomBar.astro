---
import type { Lang } from '@ferme/core';
import { brand } from '@ferme/core';
import { t } from '@/i18n';
import { href, routes, telLink } from '@/lib/paths';
import BottomCart from '@/components/islands/BottomCart';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;
const is = (to: string) => (to === '/' ? path === href(lang, '/') : path.startsWith(href(lang, to)));
const item = 'flex flex-1 flex-col items-center justify-center gap-0.5 rounded-md py-1.5 text-[11px] font-bold transition-colors';
---

<nav class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 backdrop-blur-md safe-bottom lg:hidden" aria-label="Barre de navigation" transition:persist="bottombar">
  <div class="flex items-stretch px-2" style="height: var(--bottom-bar-h)">
    <a href={href(lang)} class:list={[item, is('/') ? 'text-prairie' : 'text-ink-3']} aria-current={is('/') ? 'page' : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg>
      {d.bottomBar.home}
    </a>
    <a href={href(lang, routes.shop)} class:list={[item, is(routes.shop) ? 'text-prairie' : 'text-ink-3']} aria-current={is(routes.shop) ? 'page' : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16l-1.5 12.5a1 1 0 0 1-1 .9h-11a1 1 0 0 1-1-.9z" /><path d="M8 7a4 4 0 0 1 8 0" /></svg>
      {d.bottomBar.shop}
    </a>
    <BottomCart client:load lang={lang} href={href(lang, routes.cart)} label={d.bottomBar.cart} active={is(routes.cart)} />
    <a href={href(lang, routes.account)} class:list={[item, is(routes.account) ? 'text-prairie' : 'text-ink-3']} aria-current={is(routes.account) ? 'page' : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>
      {d.bottomBar.account}
    </a>
    <a href={telLink(brand.phone)} class:list={[item, 'text-ink-3']}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
      {d.bottomBar.call}
    </a>
  </div>
</nav>
