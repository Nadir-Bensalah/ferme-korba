---
import type { Lang } from '@ferme/core';
import { brand } from '@ferme/core';
import { t, otherLang } from '@/i18n';
import { href, routes, switchLangPath, telLink } from '@/lib/paths';
import Logo from '@/components/Logo.astro';
import CartBadge from '@/components/islands/CartBadge';
import AccountLink from '@/components/islands/AccountLink';
import SearchButton from '@/components/islands/SearchButton';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;
const nav = [
  { label: d.nav.shop, to: routes.shop },
  { label: d.nav.farm, to: routes.farm },
  { label: d.nav.quality, to: routes.quality },
  { label: d.nav.recipes, to: routes.recipes },
  { label: d.nav.contact, to: routes.contact },
];
const isActive = (to: string) => {
  const h = href(lang, to);
  return to === '/' ? path === h : path.startsWith(h);
};
const langHref = switchLangPath(path, otherLang(lang));
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md" transition:persist="header" style="height: var(--header-h)">
  <div class="container-x flex h-full items-center justify-between gap-3">
    <a href={href(lang)} class="flex shrink-0 items-center gap-2.5" aria-label={brand.name[lang]}>
      <Logo class="h-9 w-9" />
      <span class="font-display text-lg font-extrabold tracking-tight text-ink sm:text-xl">{brand.name[lang]}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation">
      {
        nav.map((n) => (
          <a
            href={href(lang, n.to)}
            class:list={[
              'rounded-pill px-4 py-2 text-sm font-semibold transition-colors',
              isActive(n.to) ? 'bg-prairie-soft text-prairie-deep' : 'text-ink-2 hover:bg-cream hover:text-ink',
            ]}
            aria-current={isActive(n.to) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <a href={langHref} class="rounded-pill px-3 py-2 text-sm font-bold text-ink-2 hover:bg-cream hover:text-ink" hreflang={otherLang(lang)} lang={otherLang(lang)} aria-label={d.nav.langLabel} data-astro-reload>
        {d.nav.lang}
      </a>
      <a href={telLink(brand.phone)} class="hidden rounded-pill p-2.5 text-ink-2 hover:bg-cream hover:text-ink sm:inline-flex lg:hidden xl:inline-flex" aria-label={`${d.nav.call} ${brand.phoneDisplay}`}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
      <SearchButton client:idle lang={lang} label={d.search.label} />
      <AccountLink client:idle lang={lang} href={href(lang, routes.account)} label={d.nav.account} />
      <CartBadge client:load lang={lang} href={href(lang, routes.cart)} label={d.nav.cart} />
      <button type="button" class="inline-flex rounded-pill p-2.5 text-ink hover:bg-cream lg:hidden" aria-label={d.nav.menu} aria-expanded="false" aria-controls="menu-mobile" data-menu-toggle>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="fixed inset-0 z-50 hidden lg:hidden" data-menu>
    <div class="absolute inset-0 bg-ink/40 backdrop-blur-sm" data-menu-close></div>
    <div class="absolute inset-y-0 end-0 flex w-[min(88vw,380px)] flex-col bg-paper shadow-float" data-menu-panel>
      <div class="flex items-center justify-between border-b border-line px-5" style="height: var(--header-h)">
        <span class="font-display text-lg font-extrabold">{d.nav.menu}</span>
        <button type="button" class="rounded-pill p-2.5 hover:bg-cream" aria-label={d.nav.close} data-menu-close>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <nav class="flex flex-col gap-1 p-4" aria-label="Navigation mobile">
        <a href={href(lang)} class:list={['rounded-md px-4 py-3 text-lg font-bold', isActive('/') ? 'bg-prairie-soft text-prairie-deep' : 'hover:bg-cream']}>{d.nav.home}</a>
        {
          nav.map((n) => (
            <a href={href(lang, n.to)} class:list={['rounded-md px-4 py-3 text-lg font-bold', isActive(n.to) ? 'bg-prairie-soft text-prairie-deep' : 'hover:bg-cream']}>
              {n.label}
            </a>
          ))
        }
        <a href={href(lang, routes.tracking)} class="rounded-md px-4 py-3 text-lg font-bold hover:bg-cream">{d.nav.track}</a>
        <a href={href(lang, routes.account)} class="rounded-md px-4 py-3 text-lg font-bold hover:bg-cream">{d.nav.account}</a>
      </nav>
      <div class="mt-auto flex flex-col gap-3 border-t border-line p-4">
        <a href={href(lang, routes.shop)} class="btn-primary btn-lg">{d.nav.order}</a>
        <a href={telLink(brand.phone)} class="btn-ghost">{d.nav.call} · {brand.phoneDisplay}</a>
        <a href={langHref} class="text-center text-sm font-bold text-ink-2" hreflang={otherLang(lang)} lang={otherLang(lang)} data-astro-reload>{d.nav.lang}</a>
      </div>
    </div>
  </div>
</header>

<script>
  function setup() {
    const header = document.querySelector('header[transition\\:persist], header');
    if (!header) return;
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-menu]');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    if (!toggle || !menu || !panel || toggle.dataset.ready) return;
    toggle.dataset.ready = '1';
    let open = false;
    const set = (v: boolean) => {
      open = v;
      toggle.setAttribute('aria-expanded', String(v));
      menu.classList.toggle('hidden', !v);
      document.documentElement.style.overflow = v ? 'hidden' : '';
      if (v) {
        panel.animate([{ transform: 'translateX(var(--menu-from))' }, { transform: 'translateX(0)' }], { duration: 320, easing: 'cubic-bezier(0.16,1,0.3,1)' });
        panel.querySelector<HTMLElement>('a, button')?.focus();
      } else toggle.focus();
    };
    panel.style.setProperty('--menu-from', document.documentElement.dir === 'rtl' ? '-100%' : '100%');
    toggle.addEventListener('click', () => set(!open));
    menu.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => set(false)));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) set(false);
    });
    document.addEventListener('astro:before-swap', () => open && set(false));
  }
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
