---
import type { Category, Lang, Product } from '@ferme/core';
import { brand, formatPrice, seedZones } from '@ferme/core';
import { t, L } from '@/i18n';
import { href, routes, telLink } from '@/lib/paths';

/**
 * Le bloc de détails de la fiche produit : quatre repères illustrés (mode de
 * vente, fraîcheur, paiement, froid), l'état du stock, la catégorie, les zones
 * de livraison avec leurs tarifs, et de quoi partager ou poser une question.
 */
interface Props {
  product: Product;
  category?: Category;
  lang: Lang;
  /** Adresse complète de la page, pour le partage. */
  url: string;
}
const { product: p, category, lang, url } = Astro.props;
const d = t(lang);
const f = d.shop.facts;
const zones = seedZones.filter((z) => z.active).sort((a, b) => a.sort - b.sort);
const mode = p.pricing.mode === 'per_piece' ? f.modePiece : p.pricing.mode === 'per_kg' ? f.modeKg : f.modeEst;
const stock = p.stock === 'en_stock' ? { label: f.stockIn, cls: 'bg-prairie' } : p.stock === 'bientot' ? { label: f.stockSoon, cls: 'bg-yolk' } : { label: f.stockOut, cls: 'bg-paprika' };
const share = `https://wa.me/?text=${encodeURIComponent(`${f.shareText(L(p.name, lang))} ${url}`)}`;
const icon = 'h-6 w-6 shrink-0 text-prairie';
---

<div class="flex flex-col gap-4">
  <div class="flex flex-wrap items-center gap-2 text-sm">
    <span class="inline-flex items-center gap-1.5 rounded-pill bg-paper px-3 py-1 font-semibold text-ink-2 shadow-card">
      <span class:list={['h-2 w-2 rounded-pill', stock.cls]} aria-hidden="true"></span>
      {stock.label}
    </span>
    {
      category && (
        <a href={href(lang, routes.category(category.slug))} class="inline-flex items-center gap-1.5 rounded-pill bg-prairie-soft px-3 py-1 font-semibold text-prairie-deep hover:bg-moss">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v8H4V4h8M14 4h6v6M20 4l-9 9" /></svg>
          {L(category.name, lang)}
        </a>
      )
    }
  </div>

  <ul class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
    <li class="flex flex-col gap-2 rounded-md bg-paper p-3 shadow-card">
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v3M5 7h14M7 7l-3 6a3 3 0 0 0 6 0L7 7ZM17 7l-3 6a3 3 0 0 0 6 0l-3-6ZM12 6v14M8 20h8" /></svg>
      <span class="text-xs font-semibold leading-snug text-ink-2">{mode}</span>
    </li>
    <li class="flex flex-col gap-2 rounded-md bg-paper p-3 shadow-card">
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18h18M5 18a7 7 0 0 1 14 0M12 4v3M4.9 8.9l2.1 2.1M19.1 8.9 17 11M2 13h2M20 13h2" /></svg>
      <span class="text-xs font-semibold leading-snug text-ink-2">{f.fresh}</span>
    </li>
    <li class="flex flex-col gap-2 rounded-md bg-paper p-3 shadow-card">
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path d="M6 9h.01M18 15h.01" /></svg>
      <span class="text-xs font-semibold leading-snug text-ink-2">{f.cod}</span>
    </li>
    <li class="flex flex-col gap-2 rounded-md bg-paper p-3 shadow-card">
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M4.9 7l14.2 10M4.9 17 19.1 7M12 2l-2 2M12 2l2 2M12 22l-2-2M12 22l2-2M4.9 7l.7 2.7M4.9 7l2.7-.7M19.1 17l-.7-2.7M19.1 17l-2.7.7M4.9 17l2.7.7M4.9 17l.7-2.7M19.1 7l-2.7-.7M19.1 7l-.7 2.7" /></svg>
      <span class="text-xs font-semibold leading-snug text-ink-2">{f.cold}</span>
    </li>
  </ul>

  <div class="rounded-lg border border-line bg-paper p-4">
    <h2 class="flex items-center gap-2 text-sm font-extrabold">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-prairie rtl:-scale-x-100"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" /></svg>
      {f.deliveryTitle}
    </h2>
    <ul class="mt-2 divide-y divide-line text-sm">
      {
        zones.map((z) => (
          <li class="flex items-center justify-between gap-3 py-1.5">
            <span class="min-w-0">
              <span class="font-semibold text-ink">{L(z.name, lang)}</span>
              <span class="ms-1.5 text-xs text-ink-3">{z.lead_days === 0 ? f.sameDay : f.nextDay}</span>
            </span>
            <span class="shrink-0 text-end tabular">
              <span class="font-semibold">{formatPrice(z.fee, lang)}</span>
              {z.free_from > 0 && <span class="block text-[11px] text-prairie">{f.freeFrom(formatPrice(z.free_from, lang))}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="flex flex-wrap gap-2">
    <a href={share} class="btn-soft btn-sm" rel="noopener" target="_blank">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8.9-.3.2-.5 0a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.8c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.7 11.5 11.5 0 0 0 4.4 3.9c1.6.7 2.3.7 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.2-.2-.2-.4-.3Z" /></svg>
      {f.share}
    </a>
    <a href={telLink(brand.phone)} class="btn-ghost btn-sm">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
      {f.ask}
    </a>
  </div>
</div>
