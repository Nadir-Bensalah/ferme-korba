---
import { photoSources } from '@/lib/img';

/**
 * Photo responsive : AVIF et WebP en 480/768/1080/1600 avec repli JPEG.
 * `src` est le chemin public sans suffixe ni extension de taille :
 *   <Picture src="/images/products/oeufs.jpg" alt="…" sizes="(min-width: 1024px) 33vw, 50vw" />
 * Les variantes viennent de scripts/images.mjs. Une image absente ne casse rien :
 * le navigateur prend le JPEG d'origine.
 */
interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
  /** Astro View Transitions : nom partagé entre la carte et la fiche. */
  transitionName?: string;
}
const { src, alt, sizes = '100vw', class: cls = '', imgClass = '', loading = 'lazy', fetchpriority = 'auto', width = 1600, height = 1067, transitionName } = Astro.props;
const p = photoSources(src);
---

<picture class={cls}>
  {p.local && <source type="image/avif" srcset={p.avif} sizes={sizes} />}
  {p.local && <source type="image/webp" srcset={p.webp} sizes={sizes} />}
  <img
    src={p.fallback}
    alt={alt}
    class={imgClass}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    width={width}
    height={height}
    sizes={sizes}
    transition:name={transitionName}
  />
</picture>
