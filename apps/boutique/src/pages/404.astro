---
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n';
import { href, routes } from '@/lib/paths';

/** Page introuvable : une seule page, français puis arabe. */
const fr = t('fr');
const ar = t('ar');
const arrow = `<svg class="rtl:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<Base lang="fr" title={fr.notFound.title} description={fr.notFound.text} noindex>
  <section class="container-x flex flex-col items-center py-16 text-center sm:py-24">
    <svg class="text-yolk" width="120" height="120" viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <path d="M14 27c0-6 5-10.5 11-10.5 3 0 5.5 1 7.2 2.8l3.3-1.3-1.6 3.8c.7 1.4 1.1 3 1.1 4.7 0 6.5-5.2 10.5-11 10.5S14 33.5 14 27Z" fill="#eaf3ea" stroke="#1e7a3c" stroke-width="1.5" />
      <path d="M30.5 15.5c1.3-2.5 3.3-3.7 5.8-3.4-.5 2.4-2 4.2-4.6 4.9l-1.2-1.5Z" fill="#c8442b" />
      <path d="M36.2 20.2 40 20.5l-2.7 2.4" fill="#f2a900" />
      <circle cx="32.2" cy="20.4" r="1.3" fill="#16201a" />
      <ellipse cx="20.5" cy="34.5" rx="3.6" ry="4.4" fill="#f2a900" />
      <path d="M8 40h32" stroke="#d3d0c4" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 5" />
    </svg>
    <p class="eyebrow mt-6">{fr.notFound.eyebrow}</p>
    <h1 class="mt-3 max-w-2xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">{fr.notFound.title}</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-2">{fr.notFound.text}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={href('fr')} class="btn-primary btn-lg">{fr.notFound.home}</a>
      <a href={href('fr', routes.shop)} class="btn-ghost btn-lg">
        {fr.notFound.shop}
        <span set:html={arrow} />
      </a>
    </div>

    <div class="mt-16 w-full max-w-2xl rounded-xl bg-cream p-6 text-center sm:p-8" lang="ar" dir="rtl">
      <p class="eyebrow">{ar.notFound.eyebrow}</p>
      <h2 class="mt-3 text-2xl font-extrabold leading-tight sm:text-3xl" style="font-family: var(--font-arabic)">{ar.notFound.title}</h2>
      <p class="mt-3 text-ink-2" style="font-family: var(--font-arabic)">{ar.notFound.text}</p>
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row" style="font-family: var(--font-arabic)">
        <a href={href('ar')} class="btn-primary" hreflang="ar" data-astro-reload>{ar.notFound.home}</a>
        <a href={href('ar', routes.shop)} class="btn-ghost" hreflang="ar" data-astro-reload>{ar.notFound.shop}</a>
      </div>
    </div>
  </section>
</Base>
