---
import type { Lang } from '@ferme/core';
import { displayPrice, seedCategories, seedProducts } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import OffersStrip from '@/components/OffersStrip.astro';
import SearchButton from '@/components/islands/SearchButton';
import Deco from '@/components/deco/Deco.astro';
import TornEdge from '@/components/deco/TornEdge.astro';
import ShopLive, { type CardSeed } from '@/components/islands/ShopLive';
import { t, L } from '@/i18n';
import { href, routes } from '@/lib/paths';

/**
 * Boutique : toutes les catégories ou une seule. Construite avec le jeu de
 * données, corrigée à l'exécution par l'îlot ShopLive (prix, stock, badges).
 */
interface Props {
  lang: Lang;
  /** Slug de la catégorie affichée, sinon tout le catalogue. */
  category?: string;
}
const { lang, category } = Astro.props;
const d = t(lang);
const cats = [...seedCategories].sort((a, b) => a.sort - b.sort);
const cat = category ? (cats.find((c) => c.slug === category) ?? null) : null;
const rank = new Map(cats.map((c, i) => [c.id, i]));
const products = (cat ? seedProducts.filter((p) => p.category_id === cat.id) : [...seedProducts]).sort(
  (a, b) => (rank.get(a.category_id) ?? 99) - (rank.get(b.category_id) ?? 99) || a.sort - b.sort,
);
const title = cat ? L(cat.name, lang) : d.shop.title;
const text = cat ? L(cat.description, lang) : d.shop.text;
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const seed: CardSeed[] = products.map((p) => {
  const price = displayPrice(p.pricing, lang);
  return { id: p.id, amount: price.amount, unit: price.unit, stock: p.stock, badges: p.badges };
});
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: L(p.name, lang),
    url: `${site}${href(lang, routes.product(p.slug))}`,
  })),
};
---

<Base lang={lang} title={title} description={text} jsonLd={itemList}>
  <section class="filigree relative overflow-clip bg-cream pb-24 pt-8 sm:pt-12">
    <Deco type="oeuf" class="deco deco-lg end-3 bottom-2 hidden w-16 rotate-6 text-yolk/25 lg:block lg:w-20" />
    <Deco type="ble" class="deco deco-lg start-1 bottom-2 hidden w-16 -rotate-12 text-prairie/20 lg:block lg:w-20" />
    <div class="container-x">
      <SectionHead as="h1" eyebrow={d.shop.breadcrumbShop} title={title} text={text} />
      <div class="mt-6 max-w-xl">
        <SearchButton client:idle lang={lang} label={d.search.label} placeholder={d.search.placeholder} wide />
      </div>
    </div>
    <TornEdge position="bottom" variant="wave" height={26} class="edge-in text-paper" />
  </section>

  <div class="cat-bar">
    <nav class="container-x" aria-label={d.shop.filter}>
      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 py-3 scrollbar-none sm:mx-0 sm:px-0">
        <a href={href(lang, routes.shop)} class="cat-chip" aria-current={!cat ? 'page' : undefined}>{d.shop.all}</a>
        {
          cats.map((c) => (
            <a href={href(lang, routes.category(c.slug))} class="cat-chip" aria-current={cat?.id === c.id ? 'page' : undefined}>
              {L(c.name, lang)}
            </a>
          ))
        }
      </div>
    </nav>
  </div>

  <section class="relative overflow-clip bg-paper pb-24 pt-6 sm:pt-8" aria-labelledby="grid-title">
    <Deco type="poule" class="deco deco-lg start-0 bottom-2 hidden w-20 text-ink/10 lg:block lg:w-24" />
    <div class="container-x">
    {!cat && <OffersStrip lang={lang} class="mb-12 mt-2 sm:mb-14" />}
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <p id="grid-title" class="text-sm font-semibold text-ink-3" data-product-count>{d.shop.count(products.length)}</p>
      <p class="chip bg-prairie-soft text-prairie-deep normal-case tracking-normal">
        <span aria-hidden="true">🌿</span> {d.shop.freshNote}
      </p>
    </div>
    <p data-shop-empty hidden={products.length > 0} class="card p-10 text-center text-ink-2">{d.shop.empty}</p>
    <div class="grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 xl:grid-cols-4">
      {
        products.map((p, i) => (
          <div data-product-id={p.id} class="flex flex-col [&>article]:flex-1">
            <ProductCard product={p} lang={lang} index={i} eager={i < 4} />
          </div>
        ))
      }
    </div>
    </div>
    <TornEdge position="bottom" variant="torn" height={26} class="edge-in text-cream" />
  </section>

  <ShopLive client:idle lang={lang} category={cat?.slug} seed={seed} />
</Base>
