  html[dir='rtl'] .hero-veil::after {
    background:
      linear-gradient(to top, rgb(12 22 14 / 0.88) 0%, rgb(12 22 14 / 0.55) 45%, rgb(12 22 14 / 0.18) 75%, transparent 100%),
      linear-gradient(to left, rgb(12 22 14 / 0.45) 0%, transparent 60%);
  }
  /* La barre de navigation du bas est fixe et recouvre les derniers pixels du
