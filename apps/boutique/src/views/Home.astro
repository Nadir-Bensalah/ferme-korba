  <script>
    import '@/scripts/vitrine';
    // Les flèches des avis font glisser la piste d'une carte, et les points suivent.
    function armTrack(name: string) {
      const track = document.querySelector<HTMLElement>(`[data-${name}-track]`);
      if (!track || track.dataset.armed) return;
      track.dataset.armed = '1';
      const step = () => (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 320;
      const dir = document.documentElement.dir === 'rtl' ? -1 : 1;
      document.querySelector(`[data-${name}-prev]`)?.addEventListener('click', () => track.scrollBy({ left: -step() * dir, behavior: 'smooth' }));
      document.querySelector(`[data-${name}-next]`)?.addEventListener('click', () => track.scrollBy({ left: step() * dir, behavior: 'smooth' }));
      const dots = Array.from(document.querySelectorAll<HTMLElement>(`[data-${name}-dots] > span`));
      const update = () => {
        const i = Math.round(Math.abs(track.scrollLeft) / (step() + 24));
        dots.forEach((d, k) => d.classList.toggle('bg-prairie-deep', k === Math.min(i, dots.length - 1)));
      };
      track.addEventListener('scroll', update, { passive: true });
    }
    const armAll = () => {
      armTrack('avis');
      armTrack('deals');
    };
    armAll();
    document.addEventListener('astro:page-load', armAll);
  </script>
