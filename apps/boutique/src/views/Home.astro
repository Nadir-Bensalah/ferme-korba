---
import type { Lang } from '@ferme/core';
import { brand, displayPrice, formatPrice, seedCategories, seedProducts, seedRecipes, seedZones } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import AddButton from '@/components/islands/AddButton';
import { photoSources } from '@/lib/img';
import ProductCard from '@/components/ProductCard.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import TrustBar from '@/components/TrustBar.astro';
import Art from '@/components/Art.astro';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/components/icons';
import Cutoff from '@/components/islands/Cutoff';
import MapSection from '@/components/MapSection.astro';
import OffersStrip from '@/components/OffersStrip.astro';
import Deco from '@/components/deco/Deco.astro';
import TornEdge from '@/components/deco/TornEdge.astro';
import { t, L } from '@/i18n';
import { href, routes, asset } from '@/lib/paths';

/** Page d'accueil : hero plein cadre, confiance, catégories, produits, étapes, ferme, recettes, avis, zones, appel final. */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

const categories = [...seedCategories].sort((a, b) => a.sort - b.sort);
const hero = photoSources('/images/farm/hero-ferme.jpg');
const featured = seedProducts.filter((p) => p.is_featured).slice(0, 6);
// Les bonnes affaires : promos d'abord, puis les plus demandés, quatre en tout.
const dealScore = (p: (typeof seedProducts)[number]) => (p.compare_at ? 8 : 0) + (p.badges.includes('promo') ? 4 : 0) + (p.badges.includes('best') ? 2 : 0) + (p.is_featured ? 1 : 0);
const deals = seedProducts
  .filter((p) => p.stock === 'en_stock')
  .sort((a, b) => dealScore(b) - dealScore(a) || a.sort - b.sort)
  .filter((p, _, all) => all.find((q) => q.category_id === p.category_id) === p)
  .slice(0, 4);
const dealTag = (p: (typeof seedProducts)[number]) => {
  const lot = p.slug.match(/x(\d+)|plateau-(\d+)/);
  if (p.compare_at && p.pricing.mode !== 'per_kg_estimated') {
    const price = p.pricing.mode === 'per_piece' ? p.pricing.price : p.pricing.price_per_kg;
    return { label: d.home.deals.off(Math.round((1 - price / p.compare_at) * 100)), cls: 'bg-paprika text-paper' };
  }
  if (lot) return { label: d.home.deals.lot(Number(lot[1] ?? lot[2])), cls: 'bg-yolk text-ink' };
  if (p.badges.includes('nouveau')) return { label: lang === 'ar' ? 'جديد' : 'Nouveau', cls: 'bg-prairie-deep text-paper' };
  return { label: d.home.deals.best, cls: 'bg-prairie-deep text-paper' };
};
const recipes = seedRecipes.slice(0, 3);
const zones = seedZones.filter((z) => z.active).sort((a, b) => a.sort - b.sort);
const trust = [...d.home.trust, ...d.home.trust, ...d.home.trust];
/** Un dessin par promesse, dans l'ordre de d.home.trust. */
const trustIcons: IconName[] = ['plein-air', 'aube', 'camion', 'especes'];
const heroBadgeIcons: IconName[] = ['plein-air', 'stock', 'aube', 'camion'];
/** Un dessin par étape, dans l'ordre de d.home.howSteps. */
const stepIcons: IconName[] = ['panier', 'telephone', 'balance', 'porte'];

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: brand.name[lang],
    url: `${site}${href(lang)}`,
    inLanguage: lang === 'ar' ? 'ar-TN' : 'fr-TN',
    description: d.meta.defaultDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: brand.name[lang],
    url: `${site}${href(lang)}`,
    logo: `${site}${asset('/favicon.svg')}`,
    telephone: brand.phone,
    email: brand.email,
    foundingDate: String(brand.since),
    address: { '@type': 'PostalAddress', streetAddress: brand.address[lang], addressLocality: 'Korba', addressRegion: 'Nabeul', postalCode: '8070', addressCountry: 'TN' },
    sameAs: [brand.social.facebook, brand.social.instagram].filter(Boolean),
  },
];

const star = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>`;
// Pictos de la carte « livraison express », au même trait que les autres.
const expressIcons: Record<'feuille' | 'ble' | 'bouclier' | 'coeur' | 'camion', string> = {
  feuille: 'M5 19c0-8 5-13 14-14 0 9-5 14-13 14M5 19c3-4 6-7 10-9',
  ble: 'M12 21V9M12 9c-3 0-5-2-5-5 3 0 5 2 5 5Zm0 0c3 0 5-2 5-5-3 0-5 2-5 5Zm0 5c-3 0-5-2-5-5 3 0 5 2 5 5Zm0 0c3 0 5-2 5-5-3 0-5 2-5 5Zm0 5c-3 0-5-2-5-5 3 0 5 2 5 5Zm0 0c3 0 5-2 5-5-3 0-5 2-5 5Z',
  bouclier: 'M12 3.2 5 6v6.1c0 4 3 6.7 7 8.2 4-1.5 7-4.2 7-8.2V6zM9 12l2.1 2.1L15.2 10',
  coeur: 'M12 21s-7-4.6-7-10.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 2.5C19 16.4 12 21 12 21Z',
  camion: 'M2.5 6.5h10.5v10H2.5zM13 10h3.6l3.9 3.6v2.9H13zM7 17.5a1.9 1.9 0 1 0 0 .01M17 17.5a1.9 1.9 0 1 0 0 .01',
};
---

<Base lang={lang} ownTrustBar description={d.meta.defaultDescription} image="/images/farm/hero-ferme.jpg" jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={hero.avif} imagesizes="100vw" fetchpriority="high" />
  </Fragment>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-ink text-paper" style="min-height: calc(100svh - var(--header-h))">
    <div class="hero-veil absolute inset-0">
      <Picture
        src="/images/farm/hero-ferme.jpg"
        alt={d.home.heroAlt}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="block h-full w-full"
        imgClass="hero-zoom h-full w-full object-cover"
      />
    </div>

    <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex justify-end px-4 pt-6 sm:px-6 lg:px-8 lg:pt-10">
      <Art name="express-carte" alt={d.home.farmScriptAlt} class="animate-float w-44 rotate-3 drop-shadow-[0_18px_30px_rgba(0,0,0,0.35)] sm:w-56 lg:w-64" width={256} height={220} sizes="256px" loading="eager" />
    </div>

    <div class="hero-inner container-x relative z-10 flex flex-col justify-end pt-24 sm:pb-20 sm:pt-48 lg:pb-28" style="min-height: calc(100svh - var(--header-h))">
      <p class="reveal eyebrow text-yolk">{d.home.heroEyebrow}</p>
      <h1 class="reveal mt-4 max-w-4xl font-display font-extrabold leading-[0.95] text-paper" style="--reveal-delay: 80ms; font-size: clamp(2.35rem, 8.5vw, 6.5rem)">
        {d.home.heroTitleLead}{' '}
        <span class="hero-accent">{d.home.heroTitleAccent}</span>
      </h1>
      <p class="reveal mt-4 max-w-xl text-base text-paper/85 sm:mt-5 sm:text-xl" style="--reveal-delay: 160ms">{d.home.heroText}</p>
      <div class="reveal mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row" style="--reveal-delay: 240ms">
        <a href={href(lang, routes.shop)} class="btn-yolk btn-lg">
          {d.home.heroCta}
          <svg class="rtl:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#comment" class="btn btn-lg border border-paper/40 bg-paper/10 text-paper backdrop-blur-sm hover:bg-paper/20">{d.home.heroCta2}</a>
      </div>

      <ul class="reveal hero-badges scrollbar-none mask-fade-x -mx-4 mt-6 flex snap-x snap-mandatory items-center gap-5 overflow-x-auto px-4 sm:mx-0 sm:mt-10 sm:flex-wrap sm:gap-x-10 sm:gap-y-5 sm:overflow-visible sm:px-0" style="--reveal-delay: 320ms">
        {
          d.home.heroBadges.map((b, i) => (
            <li class="flex shrink-0 snap-start items-center gap-2.5 sm:gap-3">
              <Icon name={heroBadgeIcons[i]!} class="h-7 w-7 shrink-0 text-paper sm:h-9 sm:w-9" strokeWidth={1.4} />
              <span class="text-[13px] font-bold leading-tight text-paper sm:text-base">
                {b.title}
                <span class="block font-semibold text-paper/80">{b.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

  </section>

  <!-- Bande de réassurance : se colle sous l'en-tête quand on l'atteint -->
  <TrustBar lang={lang} />

  <!-- Offres du moment -->
  <section class="relative overflow-hidden bg-paper pb-14 pt-14 sm:pb-16 sm:pt-16">
    <div class="container-x">
      <OffersStrip lang={lang} />
    </div>
    <TornEdge position="bottom" variant="torn" height={26} class="edge-in text-cream" />
  </section>

  <!-- Bonnes affaires : des produits frais à prix doux -->
  <section class="deals relative overflow-hidden bg-cream py-16 sm:py-20 lg:py-24">
    <Deco type="persil" class="deco start-10 top-40 hidden w-12 -rotate-12 text-prairie/25 lg:block" />
    <p class="hand pointer-events-none absolute start-16 top-10 hidden -rotate-6 text-2xl font-semibold leading-tight text-prairie-deep lg:block xl:start-24" aria-hidden="true">
      {d.home.deals.noteLeft}
      <svg class="ms-24 mt-1 h-10 w-12 text-prairie-deep rtl:-scale-x-100" viewBox="0 0 48 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6c14 2 26 12 34 28M30 30l8 4 2-9" /></svg>
    </p>
    <p class="hand pointer-events-none absolute end-16 top-10 hidden rotate-6 text-2xl font-semibold leading-tight text-prairie-deep lg:block xl:end-24" aria-hidden="true">
      {d.home.deals.noteRight} ♡
      <svg class="mt-1 h-3 w-40 text-prairie-deep" viewBox="0 0 160 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M3 8c40-6 90-6 154-2" /></svg>
    </p>
    <Art name="deals-potager" class="pointer-events-none absolute -bottom-6 -start-8 hidden w-64 lg:block xl:w-80" sizes="320px" />
    <Art name="deals-caisse" class="pointer-events-none absolute -bottom-6 -end-6 hidden w-64 lg:block xl:w-80" sizes="320px" />

    <div class="mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-24 xl:px-32">
      <div class="reveal text-center">
        <p class="eyebrow inline-flex items-center gap-2">
          <svg class="h-5 w-5 text-prairie" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14" /><path d="M5 19c3-4 6-7 10-9" /></svg>
          {d.home.deals.eyebrow}
        </p>
        <h2 class="mt-3 text-3xl font-extrabold leading-[1.05] sm:text-4xl lg:text-5xl">{d.home.deals.title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-2">{d.home.deals.text}</p>
      </div>

      <div class="relative mt-10">
        <button type="button" class="deals-arrow -start-4 lg:-start-16 xl:-start-20" data-deals-prev aria-label={d.common.previous}>
          <svg class="rtl:-scale-x-100" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
        </button>
        <button type="button" class="deals-arrow -end-4 lg:-end-16 xl:-end-20" data-deals-next aria-label={d.common.next}>
          <svg class="rtl:-scale-x-100" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
        </button>
        <ul class="deals-track scrollbar-none flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 pt-4 sm:px-6 lg:px-2 xl:gap-6" data-deals-track>
          {deals.map((p, i) => {
            const price = displayPrice(p.pricing, lang);
            const compare = p.compare_at ? formatPrice(p.compare_at, lang) : null;
            const tag = dealTag(p);
            return (
              <li class:list={['deal-card reveal relative w-[80vw] max-w-[20rem] shrink-0 snap-center rounded-3xl p-4 sm:w-[46%] lg:w-[24%] lg:max-w-none', i % 2 ? 'bg-cream-2' : 'bg-prairie-soft']} style={`--reveal-delay:${i * 80}ms`}>
                <svg class="deal-spark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 12h5M6 5l4 3M6 19l4-3" /></svg>
                <a href={href(lang, routes.product(p.slug))} class="deal-photo block overflow-hidden" tabindex="-1" aria-hidden="true">
                  <Picture src={p.images[0] ?? ''} alt="" sizes="(min-width: 1024px) 22vw, 80vw" imgClass="aspect-[4/3] w-full object-cover transition-transform duration-700 hover:scale-105" width={800} height={600} />
                </a>
                <span class:list={['deal-tag', tag.cls]} aria-hidden="true">{tag.label}</span>
                <div class="relative mt-4 px-2 pb-1">
                  <svg class="absolute end-2 top-6 h-9 w-9 text-prairie-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14" /><path d="M5 19c3-4 6-7 10-9" /></svg>
                  <h3 class="pe-12 font-display text-xl font-extrabold leading-tight">
                    <a href={href(lang, routes.product(p.slug))}>{L(p.name, lang)}</a>
                  </h3>
                  <p class="mt-1.5 pe-12 text-sm leading-snug text-ink-2">{L(p.short, lang)}</p>
                  <p class="mt-3 flex items-baseline gap-2 font-display text-2xl font-extrabold text-prairie-deep tabular">
                    {price.amount}
                    <span class="text-sm font-semibold text-ink-3">{price.unit}</span>
                    {compare && <span class="text-sm font-medium text-ink-3 line-through">{compare}</span>}
                  </p>
                  <div class="mt-3">
                    <AddButton client:visible product={{ id: p.id, slug: p.slug, name: p.name, images: p.images, pricing: p.pricing, stock: p.stock }} lang={lang} tone="green" className="min-h-12 gap-2 text-[15px]" />
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
        <div class="mt-1 flex justify-center gap-2" data-deals-dots aria-hidden="true">
          {deals.map((_, i) => (
            <span class:list={['h-2.5 w-2.5 rounded-pill bg-line-2 transition-colors', i === 0 && 'bg-prairie-deep']} />
          ))}
        </div>
      </div>

      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-start">
        {d.home.deals.trust.map(([a, b], i) => (
          <li class:list={['flex items-center gap-3', i > 0 && 'lg:border-s lg:border-line-2 lg:ps-8']}>
            <svg class="h-10 w-10 shrink-0 text-prairie-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={expressIcons[(['camion', 'feuille', 'coeur'] as const)[i]!]} /></svg>
            <span>
              <span class="block text-base font-bold leading-tight text-ink">{a}</span>
              <span class="text-sm text-ink-3">{b}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
    <TornEdge position="bottom" variant="torn" height={26} class="edge-in text-cream" />
  </section>

  <!-- Catégories -->
  <section class="filigree relative overflow-hidden bg-cream py-16 sm:py-20">
    <Deco type="oeufs" class="deco deco-lg end-0 top-4 hidden w-20 rotate-6 text-yolk/30 lg:block lg:w-24" />
    <div class="container-x">
      <SectionHead eyebrow={d.home.categoriesEyebrow} title={d.home.categoriesTitle} text={d.home.categoriesText} link={{ href: href(lang, routes.shop), label: d.common.seeAll }} />
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {categories.map((c, i) => (
          <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
            <a href={href(lang, routes.category(c.slug))} class="cat-card group flex items-center gap-3 rounded-xl bg-cream-2 p-3 pe-4 shadow-card sm:gap-4 sm:p-4 sm:pe-5">
              <div class="w-[42%] shrink-0">
                <div class={i % 2 ? 'blob-2' : 'blob'}>
                  <Picture src={c.image} alt="" sizes="(min-width: 1024px) 180px, (min-width: 640px) 22vw, 40vw" imgClass="aspect-square w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" width={800} height={800} />
                </div>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-lg font-bold leading-tight sm:text-xl">{L(c.name, lang)}</h3>
                <p class="mt-1 truncate text-sm text-ink-3">{d.home.categoryTaglines[c.slug] ?? L(c.description, lang)}</p>
              </div>
              <span class="cat-arrow flex h-11 w-11 shrink-0 items-center justify-center rounded-pill bg-paper text-prairie-deep shadow-card group-hover:bg-prairie group-hover:text-white" aria-hidden="true">
                <svg class="rtl:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <TornEdge position="bottom" variant="torn" height={26} class="edge-in text-paper" />
  </section>

  <!-- Incontournables -->
  <section class="relative overflow-hidden bg-paper py-16 sm:py-20">
    <div class="container-x">
      <SectionHead eyebrow={d.home.featuredEyebrow} title={d.home.featuredTitle} text={d.home.featuredText} link={{ href: href(lang, routes.shop), label: d.common.seeAll }} />
      <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
        {featured.map((p, i) => (
          <ProductCard product={p} lang={lang} index={i} eager={i < 2} />
        ))}
      </div>
    </div>
    <TornEdge position="bottom" variant="wave" height={28} class="edge-in text-moss" />
  </section>

  <!-- Comment ça marche -->
  <section id="comment" class="relative scroll-mt-20 overflow-hidden bg-moss py-16 sm:py-20">
    <Deco type="persil" class="deco deco-sway deco-lg start-4 top-10 hidden w-24 -rotate-6 text-prairie/25 lg:block lg:w-28" />
    <Deco type="romarin" class="deco deco-lg end-6 top-16 hidden w-20 rotate-12 text-prairie/20 lg:block lg:w-24" />
    <div class="container-x">
      <SectionHead eyebrow={d.home.howEyebrow} title={d.home.howTitle} text={d.home.howText} align="center" />
      <div class="relative mt-12">
        <svg class="draw-path pointer-events-none absolute start-6 top-4 block h-[calc(100%-2rem)] w-px lg:hidden" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true" data-draw>
          <path d="M1 0V100" pathLength="1" stroke="var(--color-yolk)" stroke-width="3" fill="none" vector-effect="non-scaling-stroke" />
        </svg>
        <svg class="draw-path pointer-events-none absolute inset-x-0 top-8 hidden h-10 w-full rtl:-scale-x-100 lg:block" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true" data-draw>
          <path d="M60 20 C 200 -10, 300 50, 440 20 S 700 -10, 940 20" pathLength="1" stroke="var(--color-yolk)" stroke-width="3" fill="none" vector-effect="non-scaling-stroke" />
        </svg>
        <ol class="relative grid gap-8 lg:grid-cols-4 lg:gap-6">
          {d.home.howSteps.map((s, i) => (
            <li class="reveal relative flex gap-5 lg:flex-col lg:items-center lg:text-center" style={`--reveal-delay:${i * 120}ms`}>
              <span class="step-badge" aria-hidden="true">
                <Icon name={stepIcons[i]!} class="h-6 w-6 text-prairie-deep lg:h-8 lg:w-8" strokeWidth={1.6} />
                <span class="step-rank">{i + 1}</span>
              </span>
              <div class="pt-2 lg:pt-0">
                <p class="eyebrow mb-1">{d.home.stepLabel(i + 1)}</p>
                <h3 class="text-xl font-bold leading-tight">{s.title}</h3>
                <p class="mt-2 text-ink-2">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="reveal mt-12 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-center sm:gap-6 sm:text-start" style="--reveal-delay: 200ms">
          <Art name={lang === 'ar' ? 'paiement-ar' : 'paiement-fr'} class="w-28 shrink-0 sm:w-32" sizes="128px" />
          <p class="max-w-md text-lg font-semibold text-prairie-deep">{d.home.codNote}</p>
        </div>
      </div>
    </div>
    <TornEdge position="bottom" variant="torn" height={26} class="edge-in text-cream-2" />
  </section>

  <!-- La ferme -->
  <section class="relative overflow-hidden bg-cream-2 py-16 sm:py-20 lg:py-28">
    <div class="mx-auto grid w-full max-w-[1600px] items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:px-10 xl:gap-24 xl:px-12">
      <div class="reveal farm-visual relative pt-24 sm:pt-28 lg:pt-32">
        <Art name="poules-heureuses" alt={d.home.farmScriptAlt} class="farm-script absolute start-0 top-0 z-20 w-60 sm:w-72 lg:w-80" width={320} height={160} sizes="320px" />
