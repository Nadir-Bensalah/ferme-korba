---
import type { Lang } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import DemoBanner from '@/components/DemoBanner.astro';
import ConfirmationPage from '@/components/islands/ConfirmationPage';
import TunnelStyles from '@/components/tunnel/TunnelStyles.astro';
import Deco from '@/components/deco/Deco.astro';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} title={d.confirmation.title} noindex>
  <TunnelStyles />
  <section class="container-x relative py-8 sm:py-12">
    <Deco type="ble" class="deco deco-lg start-4 top-10 hidden w-20 -rotate-12 text-prairie/20 xl:block" />
    <Deco type="oranger" class="deco deco-lg end-4 top-24 hidden w-24 rotate-6 text-yolk/25 xl:block" />
    <DemoBanner lang={lang} class="mx-auto mb-6 max-w-2xl" />
    <ConfirmationPage client:load lang={lang} />
  </section>
</Base>
