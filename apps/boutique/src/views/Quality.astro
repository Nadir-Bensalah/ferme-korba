---
import type { Lang } from '@ferme/core';
import { brand } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import SectionHead from '@/components/SectionHead.astro';
import Deco from '@/components/deco/Deco.astro';
import Art from '@/components/Art.astro';
import type { ArtName } from '@/components/art';
import TornEdge from '@/components/deco/TornEdge.astro';
import { t } from '@/i18n';
import { href, routes } from '@/lib/paths';

/**
 * Qualité : la vie d'un poulet de Korba racontée en six étapes qui se
 * découvrent au défilement, puis les engagements, les faits vérifiables,
 * les chiffres, les questions fréquentes et l'appel à la boutique.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

/** Dessins de la bibliothèque `Deco`, nommés ici pour ne pas importer un type depuis un .astro. */
type DecoName = 'oeufs' | 'poussin' | 'grain' | 'ble' | 'poule' | 'plume' | 'persil' | 'oeuf' | 'coriandre';

/**
 * Illustration, photo et dessin de chaque étape. Une illustration détourée
 * (`art`) passe devant la photo quand elle raconte mieux le moment : l'œuf
 * ramassé, l'éclosion, le poussin des premières semaines, la famille au grain.
 */
const storyArt: { art?: ArtName; photo: string; deco: DecoName; mask: string }[] = [
  { art: 'panier-oeufs', photo: '/images/products/oeufs.jpg', deco: 'oeufs', mask: 'blob' },
  { art: 'poussin-eclosion', photo: '', deco: 'poussin', mask: 'blob-2' },
  { art: 'poussin', photo: '/images/farm/hero-ferme.jpg', deco: 'grain', mask: 'blob-2' },
  { photo: '/images/farm/poules-plein-air.jpg', deco: 'ble', mask: 'blob' },
  { art: 'famille-volaille', photo: '/images/farm/fermier.jpg', deco: 'poule', mask: 'blob-2' },
  { photo: '/images/products/poulet-entier.jpg', deco: 'plume', mask: 'blob' },
];
const story = d.quality.story.map((s, i) => ({ ...s, ...(storyArt[i] ?? storyArt[0]!) }));

/** Libellé des boutons d'étape : « Aller à l'étape 3 : à l'abri, au chaud ». */
function goTo(i: number): string {
  const title = story[i]?.title ?? '';
  const t0 = lang === 'fr' && title ? title[0]!.toLowerCase() + title.slice(1) : title;
  return d.quality.storyGoTo.replace('{n}', String(i + 1)).replace('{title}', t0);
}

/** Pictos des engagements : plein air, nourriture, antibiotiques, froid, pesée, vétérinaire. */
const icons = [
  '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>',
  '<path d="M4 20c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M4 20c3-4 6-7 10-9"/>',
  '<path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z"/><path d="m8.5 8.5 7 7M15.5 8.5l-7 7"/>',
  '<path d="M12 2v20M2 12h20M5.5 5.5l13 13M18.5 5.5l-13 13"/><path d="M12 6 9.5 8.5M12 6l2.5 2.5M12 18l-2.5-2.5M12 18l2.5-2.5"/>',
  '<path d="M12 3v18M4 7h16M6 7l-3 7a3.5 3.5 0 0 0 7 0L7 7M17 7l-3 7a3.5 3.5 0 0 0 7 0l-3-7M8 21h8"/>',
  '<path d="M6 3v6a6 6 0 0 0 12 0V3"/><path d="M5 3h2M17 3h2M12 15v2a4 4 0 0 0 8 0v-1"/><circle cx="20" cy="15" r="1.5"/>',
];

/** Pictos des badges : durée, matin même, pas d'antibiotique, froid, balance, vétérinaire. */
const badgeIcons = [
  '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.2l3.2 2"/>',
  '<path d="M3 19h18M7.5 19a4.5 4.5 0 0 1 9 0M12 3v3.5M5.4 8.4l2 2M18.6 8.4l-2 2M2.5 14.5h2M19.5 14.5h2"/>',
  '<rect x="3" y="9" width="18" height="6" rx="3"/><path d="M9.5 9v6"/><path d="M4.5 19.5 19.5 4.5"/>',
  '<path d="M12 2.5v19M4 7l16 10M20 7 4 17"/><path d="M12 6.5 9.4 4.4M12 6.5l2.6-2.1M12 17.5l-2.6 2.1M12 17.5l2.6 2.1"/>',
  '<path d="M12 4v16M6 20h12M4 8h16M7 8l-3 6.5a3.2 3.2 0 0 0 6 0L7 8M17 8l-3 6.5a3.2 3.2 0 0 0 6 0L17 8"/>',
  '<path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z"/><path d="M9.2 12h5.6M12 9.2v5.6"/>',
];

/** Les chiffres sont les mêmes dans les deux langues : seuls l'unité et la phrase changent. */
const numberValues = ['90', '24', '4', String(brand.since)];
const numbers = d.quality.numbers.map((n, i) => ({ ...n, value: numberValues[i] ?? '', count: i < 3 }));

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: `${site}${href(lang, routes.quality)}`,
  inLanguage: lang === 'ar' ? 'ar-TN' : 'fr-TN',
  mainEntity: d.quality.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base lang={lang} title={d.quality.title} description={d.quality.lead} jsonLd={jsonLd} image="/images/farm/poules-plein-air.jpg">
  {/* 1. En-tête sur fond crème, filigrane et dessins dans les marges. */}
  <section class="filigree relative overflow-hidden bg-cream pt-12 pb-20 sm:pt-16 sm:pb-28">
    <Deco type="persil" class="deco deco-lg deco-sway start-[3%] top-14 w-24 text-prairie/30" />
    <Deco type="grain" class="deco deco-lg end-[6%] top-10 w-20 -rotate-12 text-yolk/45" />
    <Deco type="plume" class="deco deco-lg end-[3%] bottom-16 w-28 rotate-[18deg] text-prairie/25" />
    <Deco type="oeuf" class="deco -bottom-3 start-1 w-16 text-prairie/15 sm:hidden" />
    <div class="container-x">
      <Art name="medaille-premium" alt={d.common.premiumMedal} class="reveal mx-auto mb-5 h-24 w-24 -rotate-6 sm:h-28 sm:w-28" width={112} height={112} sizes="112px" loading="eager" />
      <SectionHead as="h1" eyebrow={d.quality.heroEyebrow} title={d.quality.title} text={d.quality.lead} align="center" />
    </div>
    <TornEdge position="bottom" class="text-paper" height={26} />
  </section>

  {/* 2. La frise de vie : six étapes, un trait qui se dessine, un compteur de jours,
      une scène animée qui suit le défilement (colonne collante sur ordinateur,
      vignette dans le bandeau sur téléphone). L'étape en cours vit dans
      `data-step` sur la racine : tout le reste est du CSS. */}
  <section class="relative overflow-x-clip bg-paper py-14 sm:py-20">
    <Deco type="ble" class="deco deco-lg start-[2%] top-40 w-20 -rotate-6 text-prairie/15" />
    <Deco type="coriandre" class="deco deco-lg end-[2%] bottom-32 w-24 text-prairie/15" />
    <div class="container-x">
      <SectionHead eyebrow={d.quality.storyEyebrow} title={d.quality.storyTitle} text={d.quality.storyText} align="center" />

      <div class="story-root relative mt-10" data-story-root data-step="1">
        {/* Compteur de jours : collé sous l'en-tête, il monte pendant la frise. */}
        <div class="story-meter -mx-4 sm:-mx-6 lg:-mx-8">
          <div class="relative flex items-center justify-center gap-2.5 border-y border-line bg-paper/95 px-4 py-2.5 backdrop-blur-md">
            {/* Vignette de l'étape en cours, sous 1024 px seulement. */}
            <span class="story-vignette me-1 lg:hidden" aria-hidden="true">
              <svg class="story-vig" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path class="kd" d="M6 33c8-5 20-5 28 0M10 36c6-3 14-3 20 0" />
                <path d="M20 33c-7 0-12-5-12-11 0-9 5-19 12-19s12 10 12 19c0 6-5 11-12 11Z" />
              </svg>
              <svg class="story-vig" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path class="kd" d="M6 33c8-5 20-5 28 0" />
                <path d="M20 33c-7 0-12-5-12-11 0-9 5-19 12-19s12 10 12 19c0 6-5 11-12 11Z" />
                <path class="pk" d="M11 20l4 3 3-4 4 4 3-3 4 2" />
              </svg>
              <svg class="story-vig" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <g transform="translate(20 21) scale(.32) translate(-62 -74)">
                  <path d="M42 88c0-16 9-28 22-28s22 12 22 28c0 10-9 16-22 16s-22-6-22-16Z" />
                  <path d="M52 60c-2-12 4-22 14-22s16 10 14 22" />
                  <circle cx="60" cy="48" r="2.4" fill="currentColor" stroke="none" />
                  <path class="k" stroke-width="4" d="M70 50l7 3-7 3" />
                  <path d="M54 104v6M70 104v6" />
                </g>
              </svg>
              <svg class="story-vig" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path d="M4 34h32" />
                <path d="M7 34c1-4 0-7-2-9M11 34c0-4 1-7 3-9M33 34c-1-4 0-7 2-9M29 34c0-4-1-7-3-9" />
                <circle class="kf" cx="32" cy="8" r="4" stroke="none" />
                <g transform="translate(20 22) scale(.28) translate(-62 -74)">
                  <path d="M42 88c0-16 9-28 22-28s22 12 22 28c0 10-9 16-22 16s-22-6-22-16Z" />
                  <path d="M52 60c-2-12 4-22 14-22s16 10 14 22" />
                  <circle cx="60" cy="48" r="2.4" fill="currentColor" stroke="none" />
                  <path class="k" stroke-width="4" d="M70 50l7 3-7 3" />
                  <path d="M54 104v6M70 104v6" />
                </g>
              </svg>
              <svg class="story-vig" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <g transform="translate(20 22) scale(.3) translate(-60 -70)">
                  <path d="M30 88c0-18 12-32 30-32 12 0 22 5 28 14 6 8 8 18 4 24-6 8-22 12-38 10-14-2-24-8-24-16Z" />
                  <path d="M60 56c-4-10 0-18 8-20 4 8 2 16-4 20" />
                  <path class="pk" stroke-width="3" d="M52 40c2-8 8-12 16-12-1 6-5 11-10 13" />
                  <circle cx="66" cy="50" r="2.4" fill="currentColor" stroke="none" />
                  <path class="k" stroke-width="4" d="M74 54l8 2-8 4" />
                  <path d="M52 104l4-10M70 104l2-10" />
                </g>
              </svg>
              <svg class="story-vig" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <ellipse cx="20" cy="26" rx="16" ry="6" />
                <ellipse cx="20" cy="26" rx="10" ry="3.5" class="l2" />
                <path class="kd" d="M12 24c1-7 15-7 16 0" />
                <path class="kd" d="M12 24l-4-4M28 24l4-4" />
              </svg>
            </span>
            <span class="story-days relative inline-flex" data-story-days-wrap>
              <span class="tabular font-display text-2xl leading-none font-extrabold text-prairie-deep" data-story-days>90</span>
              <svg class="story-burst" viewBox="-30 -30 60 60" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <g transform="rotate(-38)"><line class="ray" x1="0" y1="-14" x2="0" y2="-20" /></g>
                <g><line class="ray" x1="0" y1="-15" x2="0" y2="-22" /></g>
                <g transform="rotate(38)"><line class="ray" x1="0" y1="-14" x2="0" y2="-20" /></g>
              </svg>
            </span>
            <span class="text-sm font-bold text-ink-2">{d.quality.storyCounter}</span>
            {/* Six points : où on en est, et un raccourci vers chaque étape. */}
            <nav class="story-nav ms-2 flex items-center" aria-label={d.quality.storySteps}>
              {story.map((_, i) => (
                <button type="button" class="story-nav-dot" data-story-go={i + 1} aria-label={goTo(i)} aria-current={i === 0 ? 'step' : undefined} />
              ))}
            </nav>
            <span class="story-meter-bar absolute inset-x-0 bottom-0"><span class="story-meter-fill" data-story-fill></span></span>
          </div>
        </div>

        <div class="story-stage mt-10">
          {/* La scène collante, sur ordinateur seulement. Décorative : cachée aux lecteurs d'écran. */}
          <div class="story-scene-col hidden lg:block" aria-hidden="true">
            <div class="story-stage-box">
              {/* Jour 0 : l'œuf dans la paille. */}
              <svg class="story-scene" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path class="kd" d="M52 238c40-24 96-34 148-30s100 14 148 30M84 254c34-12 78-18 116-16s78 8 116 16M112 226c22-16 54-24 88-22" />
                <g class="an an-straw sc-straw"><path class="kd" d="M150 214c-14-10-30-14-48-10" /></g>
                <g class="an an-straw sc-straw sc-straw-b"><path class="kd" d="M250 214c14-10 30-14 48-10" /></g>
                <g class="an an-straw sc-straw sc-straw-c"><path class="kd" d="M204 214c-2-10 4-18 12-24" /></g>
                <g class="an an-egg sc1-egg">
                  <g transform="translate(200 172) scale(1.9) translate(-60 -70)">
                    <path class="pf" d="M60 106c-16 0-27-11-27-26 0-20 12-46 27-46s27 26 27 46c0 15-11 26-27 26Z" />
                    <path class="l2" d="M46 60c-3 6-5 12-5 18" />
                  </g>
                </g>
                <path class="kd" d="M132 240c20 10 116 10 136 0M116 246c30 6 60 8 84 8s54-2 84-8" />
                <g class="an an-straw sc-straw sc-straw-d"><path class="kd" d="M96 248c-10 4-18 12-22 22" /></g>
                <g class="an an-straw sc-straw sc-straw-e"><path class="kd" d="M304 248c10 4 18 12 22 22" /></g>
              </svg>

              {/* Jour 1 : la coquille craque, le poussin surgit. */}
              <svg class="story-scene" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path class="kd" d="M70 250c40-16 90-22 130-20s90 8 130 20M100 262c30-8 66-12 100-12s70 4 100 12" />
                <g class="an an-shelltop sc2-top">
                  <path class="pf" d="M158 188c-4-40 14-84 42-84s46 44 42 84" />
                  <path d="M158 188l10 9 11-9 10 9 11-9 10 9 11-9 10 9 11-9" />
                  <path class="l2" d="M180 140c-4 8-6 16-6 24" />
                </g>
                <g class="an an-chick sc2-chick">
                  <g transform="translate(200 236) scale(1.6) translate(-62 -110)">
                    <path d="M42 88c0-16 9-28 22-28s22 12 22 28c0 10-9 16-22 16s-22-6-22-16Z" />
                    <path d="M52 60c-2-12 4-22 14-22s16 10 14 22" />
                    <circle class="an an-blink sc-eye" cx="60" cy="48" r="1.8" fill="currentColor" stroke="none" />
                    <path class="k" d="M70 50l7 3-7 3" />
                    <path d="M54 104v6M70 104v6" />
                  </g>
                </g>
                <path class="pf" d="M158 188c-6 32 12 54 42 54s48-22 42-54" />
                <path d="M158 188l10 9 11-9 10 9 11-9 10 9 11-9 10 9 11-9" />
                <path class="an an-crack sc2-crack pk" pathLength="1" d="M170 176l10 8 8-10 10 9 9-9 11 8 8-7" />
                <g class="an an-sparks sc2-sparks kd">
                  <path d="M136 150l-8-6M262 150l8-6M120 190h-10M290 190h10M146 118l-5-9M254 118l5-9" />
                </g>
              </svg>

              {/* 3 semaines : sous la lampe. */}
              <svg class="story-scene" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path class="an an-cone sc3-cone kf" d="M178 82L96 238h208L222 82Z" stroke="none" />
                <circle class="an an-halo sc3-halo kf" cx="200" cy="86" r="30" stroke="none" />
                <path d="M200 0v42" />
                <path class="pf" d="M168 80l12-38h40l12 38Z" />
                <path class="k" d="M186 80c4 8 24 8 28 0" />
                <path class="kd" d="M96 238h208M120 250l10-8M170 252l8-8M230 252l-8-8M280 250l-10-8M150 244h14M250 244h-14" />
                <g class="an an-chick sc3-chick">
                  <g transform="translate(214 236) scale(1.5) translate(-62 -110)">
                    <path d="M42 88c0-16 9-28 22-28s22 12 22 28c0 10-9 16-22 16s-22-6-22-16Z" />
                    <path d="M52 60c-2-12 4-22 14-22s16 10 14 22" />
                    <circle class="an an-blink sc-eye" cx="60" cy="48" r="1.8" fill="currentColor" stroke="none" />
                    <path class="k" d="M70 50l7 3-7 3" />
                    <path d="M54 104v6M70 104v6" />
                  </g>
                </g>
                <g class="an an-chick sc3-chick-b">
                  <g transform="translate(150 236) scale(-1.15 1.15) translate(-62 -110)">
                    <path d="M42 88c0-16 9-28 22-28s22 12 22 28c0 10-9 16-22 16s-22-6-22-16Z" />
                    <path d="M52 60c-2-12 4-22 14-22s16 10 14 22" />
                    <circle class="an an-blink sc-eye sc-eye-b" cx="60" cy="48" r="1.8" fill="currentColor" stroke="none" />
                    <path class="k" d="M70 50l7 3-7 3" />
                    <path d="M54 104v6M70 104v6" />
                  </g>
                </g>
              </svg>

              {/* 4 semaines : la trappe s'ouvre, le poussin sort. */}
              <svg class="story-scene" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path class="kd" d="M20 232h360" />
                <path class="pf" d="M40 232V122l60-46 60 46v110" />
                <path d="M28 128l72-56 72 56" />
                <path class="l2" d="M40 150h120M40 178h60M40 206h60" />
                <path class="gf" d="M108 232v-62h44v62" />
                <g class="an an-chick sc4-walk">
                  <g class="an an-chick sc4-bob">
                    <g transform="translate(130 232) scale(1.3) translate(-62 -110)">
                      <path d="M42 88c0-16 9-28 22-28s22 12 22 28c0 10-9 16-22 16s-22-6-22-16Z" />
                      <path d="M52 60c-2-12 4-22 14-22s16 10 14 22" />
                      <circle class="an an-blink sc-eye" cx="60" cy="48" r="1.8" fill="currentColor" stroke="none" />
                      <path class="k" d="M70 50l7 3-7 3" />
                      <path d="M54 104v6M70 104v6" />
                    </g>
                  </g>
                </g>
                <g class="an an-door sc4-door">
                  <path class="pf" d="M108 170h44v62h-44Z" />
                  <path class="l2" d="M116 178v46M130 178v46M144 178v46" />
                  <circle cx="144" cy="202" r="2" fill="currentColor" stroke="none" />
                </g>
                <g class="an an-grass sc-grass"><path d="M210 232c2-8 0-16-6-22M214 232c4-8 10-12 18-14" /></g>
                <g class="an an-grass sc-grass sc-grass-b"><path d="M262 232c0-10 4-16 12-20M258 232c-4-8-10-12-18-14" /></g>
                <g class="an an-grass sc-grass sc-grass-c"><path d="M318 232c2-10-2-18-8-24M322 232c4-8 10-14 20-16" /></g>
                <g class="an an-grass sc-grass sc-grass-d"><path d="M360 232c0-8 2-14 8-18M356 232c-4-8-8-12-16-14" /></g>
                <circle class="kf" cx="330" cy="70" r="22" stroke="none" />
                <path class="k" d="M330 36v-8M330 104v8M296 70h-8M364 70h8M306 46l-6-6M354 46l6-6M306 94l-6 6M354 94l6 6" />
              </svg>

              {/* 90 jours : le coq et la poule. */}
              <svg class="story-scene" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path class="kd" d="M20 232h360" />
                <g class="an an-grass sc-grass"><path d="M40 232c2-10-2-16-8-20M44 232c4-8 10-12 18-14" /></g>
                <g class="an an-grass sc-grass sc-grass-c"><path d="M362 232c2-10-2-16-8-20M366 232c4-8 10-12 18-14" /></g>
                <g class="an an-crow sc5-coq">
                  <g transform="translate(130 232) scale(2) translate(-62 -104)">
                    <path class="pf" d="M30 88c0-18 12-32 30-32 12 0 22 5 28 14 6 8 8 18 4 24-6 8-22 12-38 10-14-2-24-8-24-16Z" />
                    <path d="M34 70c-14-6-24-18-24-34 10 2 18 10 22 20M36 76c-16-2-28-10-32-24 12-2 22 4 28 12" />
                    <path d="M60 56c-4-10 0-18 8-20 4 8 2 16-4 20" />
                    <path class="pkf" d="M52 40c2-8 8-12 16-12-1 6-5 11-10 13Z" />
                    <path class="pkf" d="M66 56c-2 5 0 8 4 8 1-4 0-7-4-8Z" />
                    <circle cx="66" cy="50" r="1.6" fill="currentColor" stroke="none" />
                    <path class="k" d="M74 54l8 2-8 4" />
                    <path d="M52 104l4-10M70 104l2-10" />
                  </g>
                </g>
                <g class="an an-wave sc5-wave k">
                  <path d="M186 124c6 8 6 18 0 26M198 114c10 14 10 32 0 46M210 104c14 20 14 46 0 66" />
                </g>
                <g class="an sc5-poule">
                  <g transform="translate(290 232) scale(-1.5 1.5) translate(-62 -104)">
                    <path class="pf" d="M30 88c0-18 12-32 30-32 12 0 22 5 28 14 6 8 8 18 4 24-6 8-22 12-38 10-14-2-24-8-24-16Z" />
                    <g class="an an-peck sc5-tete">
