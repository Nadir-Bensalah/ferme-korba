    <Deco type="ble" class="deco deco-lg -end-4 top-6 w-32 rotate-6 text-yolk/25" />
    <Deco type="poule" class="deco deco-lg -start-6 bottom-2 w-40 text-yolk/20" />
    <div class="container-x reveal relative">
      <h2 class="mx-auto max-w-3xl text-3xl leading-[1.05] font-extrabold text-yolk sm:text-4xl lg:text-5xl">{d.quality.ctaTitle}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-paper/85">{d.quality.ctaText}</p>
      <a href={href(lang, routes.shop)} class="btn-yolk btn-lg mt-8">
        {d.quality.cta}
        <svg class="rtl:rotate-180" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
