                    </g>
                    <circle class="kf" cx="300" cy="150" r="34" stroke="none" />
                  </g>
                  <path class="gf" d="M0 236c40-52 110-88 200-86s150 40 200 86Z" />
                  <path class="kd" d="M0 236h400" />
                  <path class="l2" d="M0 262h400" />
                  <path class="l2" stroke-dasharray="14 12" d="M0 250h400" />
                  <g class="an an-truck sc6-truck">
                    <path class="pf" d="M40 210h72v42H40Z" />
                    <path d="M76 220v18M68 224l16 10M84 224l-16 10" />
                    <path class="pf" d="M112 222h26l14 14v16h-40Z" />
                    <path class="l2" d="M118 226h16v10h-16Z" />
                    <circle class="pf" cx="58" cy="255" r="7" />
                    <circle class="pf" cx="134" cy="255" r="7" />
