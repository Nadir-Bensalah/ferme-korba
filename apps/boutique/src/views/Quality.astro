  <script>
    import '@/scripts/vitrine';
  </script>

  <script>
    // Frise de vie. Le trait vert se dessine à mesure qu'on descend, le compteur
    // de jours monte avec lui, et un marqueur voyage à la pointe du trait : quand
    // il touche une pastille, l'étape s'allume. L'étape en cours vit dans
    // `data-step` sur la racine ; la scène, la vignette, les cartes et les
    // points du bandeau ne sont que du CSS derrière. Sans JS, ou en mouvement
    // réduit, le trait est plein et le compteur affiche 90 : rien n'est masqué.
    // En mouvement réduit, l'étape en cours suit quand même le défilement, par
    // un observateur, pour que la scène montre la bonne image sans bouger.
    const MAX_DAYS = 90;
    const STEPS = 6;
    let root: HTMLElement | null = null;
    let wrap: HTMLElement | null = null;
    let days: HTMLElement | null = null;
    let fill: HTMLElement | null = null;
    let steps: HTMLElement[] = [];
    let offsets: number[] = [];
    let wrapH = 0;
    let near = false;
    let queued = false;
    let burst = false;
    let io: IntersectionObserver | null = null;
    let armed = false;

    function setStep(n: number) {
      if (!root) return;
      const cur = Number(root.dataset.step || '1');
      if (cur === n) return;
      root.dataset.step = String(n);
      root.querySelectorAll<HTMLElement>('[data-story-go]').forEach((b) => {
        if (Number(b.dataset.storyGo) === n) b.setAttribute('aria-current', 'step');
        else b.removeAttribute('aria-current');
      });
    }

    /* Position des pastilles dans le rail, relevée quand sa hauteur change. */
    function measure() {
      offsets = steps.map((li) => li.offsetTop);
    }

    function paint() {
      queued = false;
      if (!wrap) return;
      const r = wrap.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const span = Math.max(1, r.height - vh * 0.3);
      let p = (vh * 0.7 - r.top) / span;
      p = p < 0 ? 0 : p > 1 ? 1 : p;
      if (r.height !== wrapH) {
        wrapH = r.height;
        measure();
      }
      // Le trait court de 0,75 rem à 0,75 rem du bord : le marqueur suit sa pointe.
      const tip = p * Math.max(0, r.height - 24);
      let n = 1;
      for (let i = 1; i < offsets.length; i++) if (tip + 12 >= (offsets[i] ?? 0)) n = i + 1;
      wrap.style.setProperty('--story-progress', String(1 - p));
      wrap.style.setProperty('--story-y', `${Math.round(tip)}px`);
      if (fill) fill.style.setProperty('--story-fill', `${Math.round(p * 100)}%`);
      const dcount = Math.round(p * MAX_DAYS);
      if (days) days.textContent = String(dcount);
      if (dcount === MAX_DAYS && !burst && days?.parentElement) {
        burst = true;
        days.parentElement.classList.add('is-burst');
      }
      setStep(Math.min(STEPS, n));
    }

    function onScroll() {
      if (!near || queued) return;
      queued = true;
      requestAnimationFrame(paint);
    }

    /* Clic sur une pastille ou un point du bandeau : on file à l'étape. */
    function onClick(e: Event) {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-story-go]');
      if (!b) return;
      const li = document.getElementById(`etape-${b.dataset.storyGo}`);
      if (!li) return;
      li.scrollIntoView({ block: 'start' });
    }

    function teardown() {
      if (io) io.disconnect();
      io = null;
      near = false;
      if (armed) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        armed = false;
      }
      root = wrap = days = fill = null;
      steps = [];
      offsets = [];
      wrapH = 0;
    }

    function setup() {
      teardown();
      root = document.querySelector<HTMLElement>('[data-story-root]');
      wrap = document.querySelector<HTMLElement>('[data-story]');
      days = document.querySelector<HTMLElement>('[data-story-days]');
      fill = document.querySelector<HTMLElement>('[data-story-fill]');
      if (!root || !wrap) return;
      steps = Array.from(wrap.querySelectorAll<HTMLElement>('.story-step'));
      root.addEventListener('click', onClick);
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Pas de trait qui court ni de compteur : seule l'étape en cours change,
        // quand une carte passe la ligne des 70 % de l'écran.
        const seen = new Array<boolean>(steps.length).fill(false);
        io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              const i = steps.indexOf(en.target as HTMLElement);
              if (i < 0) continue;
              seen[i] = en.boundingClientRect.top <= window.innerHeight * 0.7;
            }
            let n = 1;
            for (let i = 1; i < seen.length; i++) if (seen[i]) n = i + 1;
            setStep(n);
          },
          { rootMargin: '0px 0px -30% 0px' },
        );
        steps.forEach((li) => io!.observe(li));
        return;
      }
      root.dataset.storyLive = '1';
      wrap.dataset.storyLive = '1';
      near = true;
      armed = true;
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      paint();
      io = new IntersectionObserver(
        (entries) => {
          for (const en of entries) near = en.isIntersecting;
          if (near) paint();
        },
        { rootMargin: '200px 0px 200px 0px' },
      );
      io.observe(wrap);
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', teardown);
  </script>

  <script>
    // FAQ : ouverture et fermeture animées en hauteur. Sans JS, <details> fait le travail.
    function setupFaq() {
      document.querySelectorAll<HTMLDetailsElement>('details[data-faq]:not([data-ready])').forEach((el) => {
        el.dataset.ready = '1';
        const summary = el.querySelector('summary');
        const body = el.querySelector<HTMLElement>('.faq-body');
        if (!summary || !body) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        summary.addEventListener('click', (e) => {
          if (reduced) return;
          e.preventDefault();
          if (el.open) {
            el.classList.add('is-closing');
            const done = () => {
              el.open = false;
              el.classList.remove('is-closing');
              body.removeEventListener('transitionend', done);
            };
            body.addEventListener('transitionend', done);
            setTimeout(done, 450);
          } else {
            el.classList.add('is-closing');
            el.open = true;
            void body.offsetHeight;
            el.classList.remove('is-closing');
          }
        });
      });
    }
    setupFaq();
    document.addEventListener('astro:page-load', setupFaq);
  </script>
</Base>
