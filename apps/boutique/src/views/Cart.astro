---
import type { Lang } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import DemoBanner from '@/components/DemoBanner.astro';
import CartPage from '@/components/islands/CartPage';
import TunnelStyles from '@/components/tunnel/TunnelStyles.astro';
import Deco from '@/components/deco/Deco.astro';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<Base lang={lang} title={d.cart.title} noindex>
  <TunnelStyles />
  <section class="container-x relative py-8 sm:py-12">
    <Deco type="persil" class="deco deco-lg deco-sway end-2 top-6 hidden w-24 rotate-6 text-prairie/20 xl:block" />
    <DemoBanner lang={lang} class="mb-5" />
    <h1 class="text-3xl font-extrabold sm:text-4xl">{d.cart.title}</h1>
    <div class="mt-6">
      <CartPage client:load lang={lang} />
    </div>
  </section>
</Base>
