---
import type { Lang, Recipe as RecipeType } from '@ferme/core';
import { brand, seedProducts, seedRecipes } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import ProductCard from '@/components/ProductCard.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import RecipeCart from '@/components/islands/RecipeCart';
import { t, L } from '@/i18n';
import { href, routes, asset } from '@/lib/paths';

/** Une recette : photo, ingrédients cochables, étapes, produits de la boutique, autres recettes. */
interface Props {
  lang: Lang;
  recipe: RecipeType;
}
const { lang, recipe: r } = Astro.props;
const d = t(lang);

const ingredients = r.ingredients[lang];
const steps = r.steps[lang];
const products = r.product_slugs.map((slug) => seedProducts.find((p) => p.slug === slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const snapshots = products.map((p) => ({ id: p.id, slug: p.slug, name: p.name, images: p.images, pricing: p.pricing, stock: p.stock }));
const others = seedRecipes.filter((x) => x.id !== r.id).slice(0, 3);
const difficulty = d.common.difficulty[r.difficulty - 1] ?? '';

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: L(r.title, lang),
  description: L(r.intro, lang),
  image: `${site}${asset(r.image)}`,
  url: `${site}${href(lang, routes.recipe(r.slug))}`,
  inLanguage: lang === 'ar' ? 'ar-TN' : 'fr-TN',
  author: { '@type': 'Organization', name: brand.name[lang] },
  totalTime: `PT${r.duration_min}M`,
  recipeYield: `${r.servings}`,
  recipeCategory: lang === 'ar' ? 'طبق رئيسي' : 'Plat principal',
  recipeCuisine: lang === 'ar' ? 'تونسية' : 'Tunisienne',
  recipeIngredient: ingredients,
  recipeInstructions: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })),
};
---

<Base lang={lang} title={L(r.title, lang)} description={L(r.intro, lang)} image={r.image} jsonLd={jsonLd}>
  <article class="container-x py-8 sm:py-12">
    <nav class="mb-6 text-sm text-ink-3" aria-label={d.common.back}>
      <a href={href(lang, routes.recipes)} class="inline-flex items-center gap-1.5 font-semibold text-prairie hover:text-prairie-deep">
        <svg class="rtl:rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        {d.recipes.title}
      </a>
    </nav>

    <header class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-xl shadow-float">
        <Picture src={r.image} alt={L(r.title, lang)} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" imgClass="aspect-[4/3] w-full object-cover" width={1600} height={1200} transitionName={`recipe-${r.id}`} />
      </div>
      <div>
        <p class="eyebrow">{d.recipes.eyebrow}</p>
        <h1 class="mt-3 text-3xl font-extrabold leading-[1.05] sm:text-4xl lg:text-5xl">{L(r.title, lang)}</h1>
        <p class="prose-farm mt-5">{L(r.intro, lang)}</p>
        <dl class="mt-6 flex flex-wrap gap-2">
          <div class="flex items-center gap-2 rounded-pill bg-cream px-4 py-2 text-sm font-bold text-ink-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            <dt class="sr-only">{d.recipes.duration}</dt>
            <dd class="tabular">{r.duration_min} {d.common.minutes}</dd>
          </div>
          <div class="flex items-center gap-2 rounded-pill bg-cream px-4 py-2 text-sm font-bold text-ink-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><circle cx="17" cy="9" r="2.5" /><path d="M15.5 14.5a5 5 0 0 1 6 5" /></svg>
            <dt class="sr-only">{d.recipes.servingsLabel}</dt>
            <dd>{d.recipes.forServings(r.servings)}</dd>
          </div>
          <div class="flex items-center gap-2 rounded-pill bg-cream px-4 py-2 text-sm font-bold text-ink-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2" /></svg>
            <dt class="sr-only">{d.recipes.difficultyLabel}</dt>
            <dd>{difficulty}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
      <section class="reveal lg:sticky lg:top-24 lg:self-start" aria-labelledby="ingredients">
        <div class="rounded-lg bg-cream p-5 sm:p-6">
          <div class="flex items-end justify-between gap-3">
            <h2 id="ingredients" class="text-2xl font-extrabold">{d.recipes.ingredients}</h2>
            <button type="button" class="text-sm font-bold text-prairie hover:text-prairie-deep" data-uncheck={`ferme-korba:recipe:${r.id}`}>{d.recipes.uncheck}</button>
          </div>
          <p class="mt-1 text-sm text-ink-3">{d.recipes.checkHint}</p>
          <ul class="mt-4 flex flex-col divide-y divide-line-2/60" data-ingredients={`ferme-korba:recipe:${r.id}`}>
            {ingredients.map((ing, i) => (
              <li class="ingredient">
                <label class="flex min-h-12 cursor-pointer items-center gap-3 py-2.5">
                  <input type="checkbox" class="h-5 w-5 shrink-0 accent-prairie" value={i} />
                  <span class="ingredient-label text-base text-ink transition-colors">{ing}</span>
                </label>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="reveal" aria-labelledby="steps" style="--reveal-delay: 80ms">
        <h2 id="steps" class="text-2xl font-extrabold">{d.recipes.steps}</h2>
        <ol class="mt-6 flex flex-col gap-6">
          {steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-pill bg-ink font-display text-base font-extrabold text-yolk" aria-hidden="true">
                {i + 1}
              </span>
              <div class="pt-1.5">
                <p class="sr-only">{d.recipes.step(i + 1)}</p>
                <p class="text-lg leading-relaxed text-ink-2">{s}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>

    {
      products.length > 0 && (
        <section class="mt-16 rounded-xl bg-moss p-5 sm:p-8 lg:mt-20" aria-labelledby="produits">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow mb-2">{d.nav.shop}</p>
              <h2 id="produits" class="text-2xl font-extrabold sm:text-3xl">{d.recipes.products}</h2>
              <p class="mt-2 text-ink-2">{d.recipes.addAllHelp}</p>
            </div>
            <RecipeCart client:visible products={snapshots} lang={lang} />
          </div>
          <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
            {products.map((p, i) => (
              <ProductCard product={p} lang={lang} index={i} />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <section class="container-x pb-4 pt-8">
    <div class="flex items-end justify-between gap-3">
      <h2 class="text-2xl font-extrabold sm:text-3xl">{d.recipes.more}</h2>
      <a href={href(lang, routes.recipes)} class="font-bold text-prairie hover:text-prairie-deep">{d.common.seeAll}</a>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {others.map((o, i) => (
        <RecipeCard recipe={o} lang={lang} index={i} />
      ))}
    </div>
  </section>

  <script>
    // Ingrédients cochés, mémorisés par recette sur l'appareil.
    function setup() {
      document.querySelectorAll<HTMLElement>('[data-ingredients]:not([data-ready])').forEach((list) => {
        list.dataset.ready = '1';
        const key = list.dataset.ingredients ?? '';
        const inputs = Array.from(list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
        const read = (): number[] => {
          try {
            const v = JSON.parse(localStorage.getItem(key) ?? '[]');
            return Array.isArray(v) ? v.filter((n) => Number.isInteger(n)) : [];
          } catch {
            return [];
          }
        };
        const write = () => {
          try {
            const checked = inputs.filter((i) => i.checked).map((i) => Number(i.value));
            if (checked.length) localStorage.setItem(key, JSON.stringify(checked));
            else localStorage.removeItem(key);
          } catch {
            /* stockage indisponible : on continue sans mémoire */
          }
        };
        const saved = read();
        inputs.forEach((i) => {
          i.checked = saved.includes(Number(i.value));
          i.addEventListener('change', write);
        });
        document.querySelectorAll<HTMLButtonElement>(`[data-uncheck="${CSS.escape(key)}"]`).forEach((btn) =>
          btn.addEventListener('click', () => {
            inputs.forEach((i) => (i.checked = false));
            write();
          }),
        );
      });
    }
    setup();
    document.addEventListener('astro:page-load', setup);
  </script>
</Base>
