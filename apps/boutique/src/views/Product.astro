---
import type { Lang, Product } from '@ferme/core';
import { brand, displayPrice, formatPrice, seedCategories, seedProducts, seedRecipes } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import Badges from '@/components/Badges.astro';
import ProductCard from '@/components/ProductCard.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import ProductGallery from '@/components/ProductGallery.astro';
import Deco from '@/components/deco/Deco.astro';
import TornEdge from '@/components/deco/TornEdge.astro';
import ProductBuy from '@/components/islands/ProductBuy';
import BackToTop from '@/components/islands/BackToTop';
import Cutoff from '@/components/islands/Cutoff';
import ProductFacts from '@/components/ProductFacts.astro';
import Art from '@/components/Art.astro';
import { t, L, locale } from '@/i18n';
import { href, routes, asset } from '@/lib/paths';

/**
 * Fiche produit. Le prix, le stock et les badges sont posés à la construction
 * puis corrigés à l'exécution par ProductBuy (éléments #live-*).
 */
interface Props {
  lang: Lang;
  product: Product;
}
const { lang, product: p } = Astro.props;
const d = t(lang);
const cat = seedCategories.find((c) => c.id === p.category_id) ?? null;
const price = displayPrice(p.pricing, lang);
const estimated = p.pricing.mode === 'per_kg_estimated';
const compare = p.compare_at ? formatPrice(p.compare_at, lang) : null;
const image = p.images[0] ?? '/images/products/poulet-entier.jpg';
const nf = new Intl.NumberFormat(locale(lang), { maximumFractionDigits: 2 });
const modeText =
  p.pricing.mode === 'per_piece'
    ? d.shop.modePiece
    : p.pricing.mode === 'per_kg'
      ? d.shop.modeKg(`${nf.format(p.pricing.step_kg)} ${d.shop.kgLabel}`)
      : d.shop.modeEstimated(nf.format(p.pricing.est_weight_kg));
const rangeText =
  p.pricing.mode === 'per_kg_estimated' && p.pricing.min_weight_kg && p.pricing.max_weight_kg
    ? d.shop.weightRange(nf.format(p.pricing.min_weight_kg), nf.format(p.pricing.max_weight_kg))
    : null;
const related = seedProducts
  .filter((x) => x.category_id === p.category_id && x.id !== p.id)
  .sort((a, b) => a.sort - b.sort)
  .slice(0, 4);
/** Recettes qui citent vraiment ce produit. Aucune n'est inventée. */
const recipes = seedRecipes.filter((r) => r.product_slugs.includes(p.slug)).slice(0, 3);
/** Le bandeau n'apparaît que si le produit porte le badge « le plus demandé ». */
const isPopular = p.badges.includes('best');

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const url = `${site}${href(lang, routes.product(p.slug))}`;
const unitPrice = p.pricing.mode === 'per_piece' ? p.pricing.price : p.pricing.price_per_kg;
const availability = p.stock === 'rupture' ? 'https://schema.org/OutOfStock' : p.stock === 'bientot' ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock';
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: L(p.name, lang),
  description: L(p.short, lang),
  image: [`${site}${asset(image)}`],
  sku: p.id,
  category: cat ? L(cat.name, lang) : undefined,
  brand: { '@type': 'Brand', name: brand.name[lang] },
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'TND',
    price: unitPrice.toFixed(3),
    availability,
    itemCondition: 'https://schema.org/NewCondition',
    ...(p.pricing.mode !== 'per_piece' && {
      priceSpecification: { '@type': 'UnitPriceSpecification', price: unitPrice.toFixed(3), priceCurrency: 'TND', unitCode: 'KGM' },
    }),
  },
};
const crumbs = [
  { name: d.nav.home, url: `${site}${href(lang)}` },
  { name: d.shop.breadcrumbShop, url: `${site}${href(lang, routes.shop)}` },
  ...(cat ? [{ name: L(cat.name, lang), url: `${site}${href(lang, routes.category(cat.slug))}` }] : []),
  { name: L(p.name, lang), url },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
};
const sep = 'text-ink-3 select-none';
const hasRelated = related.length > 0 && Boolean(cat);
const hasRecipes = recipes.length > 0;
/** Le cran précédent du fil d'Ariane, pour la flèche de retour sur mobile. */
const parent = crumbs[crumbs.length - 2] ?? crumbs[0]!;
---

<Base lang={lang} title={L(p.name, lang)} description={L(p.short, lang)} image={image} jsonLd={[productLd, breadcrumbLd]}>
  <div class="relative bg-paper pb-20">
    <Deco type="plume" class="deco deco-lg end-2 top-4 hidden w-16 rotate-12 text-prairie/20 lg:block lg:w-20" />
    <Deco type="grain" class="deco deco-lg start-1 bottom-2 hidden w-16 -rotate-6 text-ink/10 lg:block lg:w-20" />
    <div class="container-x pt-5 sm:pt-8">
    <nav aria-label={d.shop.breadcrumb} class="crumbs text-sm text-ink-3">
      <a href={parent.url.slice(site.length)} class="crumb-back" aria-label={d.shop.backTo(parent.name)}>
        <svg class="rtl:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"></path></svg>
      </a>
      <ol class="crumb-list scrollbar-none">
        {
          crumbs.map((c, i) => (
            <li class="flex shrink-0 items-center gap-1.5">
              {i > 0 && (
                <span class={sep} aria-hidden="true">
                  /
                </span>
              )}
              {i === crumbs.length - 1 ? (
                <span aria-current="page" class="font-semibold text-ink">
                  {c.name}
                </span>
              ) : (
                <a href={c.url.slice(site.length)} class="transition-colors hover:text-ink">
                  {c.name}
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="mt-6 grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
      <!-- La photo reste en place pendant que la colonne de droite défile, et
           repart quand celle-ci est finie. Le collage n'opère qu'à partir de
           1024 px : en dessous, les deux colonnes sont l'une sous l'autre. -->
      <div class="product-sticky lg:sticky lg:self-start">
        <ProductGallery images={p.images} alt={L(p.name, lang)} lang={lang} grayscale={p.stock === 'rupture'} transitionName={`product-${p.id}`}>
          <div slot="overlay" class="pointer-events-none absolute start-3 top-3 z-[2] flex flex-col items-start gap-1.5">
            <span id="live-badges" class="flex flex-col items-start gap-1.5"><Badges badges={p.badges} lang={lang} /></span>
            <span id="live-stock" class={p.stock === 'rupture' ? 'chip bg-ink text-paper' : 'chip bg-paper/90 text-ink-2'} hidden={p.stock === 'en_stock'}>
              {p.stock === 'rupture' ? d.common.outOfStock : d.common.soon}
            </span>
          </div>
        </ProductGallery>
      </div>

      <div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          {
            isPopular && (
              <p class="popular-note">
                <Icon name="etoile" class="h-3.5 w-3.5 shrink-0 text-yolk-deep" />
                {d.shop.popular}
              </p>
            )
          }
          <h1 class="text-3xl font-extrabold leading-tight sm:text-4xl">{L(p.name, lang)}</h1>
          <p class="text-lg text-ink-2">{L(p.short, lang)}</p>
        </div>
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          {estimated && <span class="text-xs font-semibold uppercase tracking-wide text-ink-3">{d.common.from}</span>}
          <span id="live-price-amount" class="font-display text-3xl font-extrabold tabular">{price.amount}</span>
          <span id="live-price-unit" class="font-semibold text-ink-3">{price.unit}</span>
          {compare && <span class="text-sm text-ink-3 line-through tabular">{compare}</span>}
        </div>
        <p class="rounded-md bg-cream px-4 py-3 text-sm text-ink-2">
          {modeText}
          {rangeText && <span class="block text-ink-3">{rangeText}</span>}
        </p>

        <ProductBuy client:load product={{ id: p.id, slug: p.slug, name: p.name, images: p.images, pricing: p.pricing, stock: p.stock, badges: p.badges }} lang={lang} />

        <Art name="badges-confiance" alt={d.common.trustStrip} class="w-full" width={1400} height={159} sizes="(min-width: 1024px) 560px, 100vw" />

        <p class="text-sm font-semibold text-prairie-deep">
          <Cutoff client:idle lang={lang} variant="inline" fallback={d.shop.deliveredTomorrow} />
        </p>

        <div class="prose-farm text-base">
          <p>{L(p.description, lang)}</p>
        </div>

        {
          p.tips && (
            <div class="flex gap-3 rounded-lg bg-yolk-soft p-4">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0 text-yolk-deep"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2Z" /></svg>
              <div>
                <h2 class="text-base font-extrabold">{d.shop.tips}</h2>
                <p class="mt-1 text-sm text-ink-2">{L(p.tips, lang)}</p>
              </div>
            </div>
          )
        }

        <ProductFacts product={p} category={cat ?? undefined} lang={lang} url={`${site}${Astro.url.pathname}`} />
      </div>
    </article>
    </div>
    <TornEdge position="bottom" variant="wave" height={28} class:list={['edge-in', hasRecipes ? 'text-cream' : hasRelated ? 'text-moss' : 'text-cream']} />
  </div>

  {
    hasRecipes && (
      <section class="filigree relative overflow-clip bg-cream pb-16 pt-14 sm:pt-16" aria-label={d.shop.withRecipes}>
        <Deco type="piment" class="deco deco-lg end-3 top-6 hidden w-16 rotate-6 text-paprika/20 lg:block" />
        <div class="container-x">
          <SectionHead eyebrow={d.home.recipesEyebrow} title={d.shop.withRecipes} text={d.shop.withRecipesText} link={{ href: href(lang, routes.recipes), label: d.common.seeAll }} />
          <div class:list={['mt-8 grid gap-4 sm:grid-cols-2 sm:gap-5', recipes.length > 2 ? 'lg:grid-cols-3' : 'max-w-3xl']}>
            {recipes.map((r, i) => (
              <RecipeCard recipe={r} lang={lang} index={i} />
            ))}
          </div>
        </div>
        <TornEdge position="bottom" variant="torn" height={26} class:list={['edge-in', hasRelated ? 'text-moss' : 'text-cream']} />
      </section>
    )
  }

  {
    hasRelated && cat && (
      <section class="filigree filigree-green filigree-quiet relative overflow-clip bg-moss pb-20 pt-14 sm:pt-16" aria-label={d.shop.inCategory}>
        <Deco type="ail" class="deco deco-lg end-3 bottom-2 hidden w-16 rotate-6 text-ink/10 lg:block" />
        <div class="container-x">
          <SectionHead title={d.shop.inCategory} link={{ href: href(lang, routes.category(cat.slug)), label: d.common.seeAll }} />
          <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 xl:grid-cols-4">
            {related.map((r, i) => (
              <ProductCard product={r} lang={lang} index={i} />
            ))}
          </div>
        </div>
        <TornEdge position="bottom" variant="torn" height={26} class="edge-in text-cream" />
      </section>
    )
  }

  <BackToTop client:idle lang={lang} />
</Base>

<style>
  /* Le fil d'Ariane tient sur une ligne et se fait glisser au doigt, avec une
     flèche de retour au cran précédent toujours à portée de pouce. */
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .crumb-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-inline-start: -0.5rem;
    flex: none;
    border-radius: var(--radius-pill);
    color: var(--color-ink-2);
    transition:
      background-color 0.2s,
      transform 0.25s var(--ease-out-expo);
  }
  .crumb-back:hover {
    background: var(--color-cream);
    transform: translateX(-2px);
  }
  html[dir='rtl'] .crumb-back:hover {
    transform: translateX(2px);
  }
  .crumb-list {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    padding-block: 0.25rem;
    mask-image: linear-gradient(to right, black 88%, transparent);
  }
  @media (min-width: 640px) {
    .crumb-list {
      mask-image: none;
      flex-wrap: wrap;
      white-space: normal;
    }
  }

  /* Bandeau « parmi les plus commandés » : affiché seulement quand le badge
     existe vraiment sur le produit, jamais comme argument de vente inventé. */
  .popular-note {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-yolk-soft);
    color: var(--color-yolk-deep);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .crumb-back {
      transition: none;
    }
    .crumb-back:hover {
      transform: none;
    }
  }
</style>

<style>
  /* Le haut de la photo se cale sous l'en-tête collant, avec un peu d'air. */
  .product-sticky {
    top: calc(var(--stick-top) + 1rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .product-sticky {
      position: static;
    }
  }
</style>
