---
import type { Lang } from '@ferme/core';
import { seedRecipes } from '@ferme/core';
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Deco from '@/components/deco/Deco.astro';
import TornEdge from '@/components/deco/TornEdge.astro';
import { t, L } from '@/i18n';
import { href, routes } from '@/lib/paths';

/**
 * Liste des recettes : la plus rapide mise en avant pour le soir même,
 * puis un filtre par temps et par difficulté. Sans JavaScript, le filtre
 * ne s'affiche pas et toutes les recettes restent visibles.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

/** La plus rapide de la liste : c'est elle qu'on propose pour ce soir. */
const tonight = [...seedRecipes].sort((a, b) => a.duration_min - b.duration_min)[0]!;

const timeFilters = [
  { value: 'all', label: d.recipes.filterAll },
  { value: '30', label: d.recipes.filterQuick },
  { value: '60', label: d.recipes.filterMid },
  { value: 'long', label: d.recipes.filterLong },
];
const diffFilters = [{ value: 'all', label: d.recipes.filterAll }, ...d.common.difficulty.map((label, i) => ({ value: String(i + 1), label }))];
---

<Base lang={lang} title={d.recipes.title} description={d.recipes.text} image="/images/recipes/recette-poulet-roti.jpg">
  <section class="filigree relative overflow-clip bg-cream pt-12 pb-24 sm:pt-16">
    <Deco type="persil" class="deco deco-sway deco-lg start-3 bottom-1 hidden w-16 -rotate-6 text-prairie/25 lg:block lg:w-20" />
    <Deco type="piment" class="deco deco-lg end-4 bottom-1 hidden w-16 rotate-12 text-paprika/20 lg:block" />
    <div class="container-x">
      <SectionHead as="h1" eyebrow={d.recipes.eyebrow} title={d.recipes.title} text={d.recipes.text} link={{ href: href(lang, routes.shop), label: d.nav.shop }} />

      {/* Ce soir : la recette la plus rapide, avec sa photo et son temps. */}
      <a href={href(lang, routes.recipe(tonight.slug))} class="tonight reveal group mt-10 flex flex-col items-stretch gap-5 rounded-xl bg-paper p-4 shadow-card transition-shadow hover:shadow-float sm:flex-row sm:items-center sm:gap-7 sm:p-5" style="--reveal-delay: 90ms">
        <span class="tonight-photo blob relative block w-full shrink-0 overflow-hidden sm:w-56 lg:w-64">
          <Picture src={tonight.image} alt="" sizes="(min-width: 640px) 16rem, 100vw" imgClass="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105" width={1600} height={1200} />
        </span>
        <span class="flex min-w-0 flex-1 flex-col gap-2">
          <span class="eyebrow flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
            </svg>
            {d.recipes.tonightEyebrow}
          </span>
          <span class="block text-2xl leading-tight font-extrabold sm:text-3xl">{d.recipes.tonightTitle}</span>
          <span class="block text-ink-2">{d.recipes.tonightText(tonight.duration_min)}</span>
          <span class="mt-1 block text-lg font-bold text-prairie">{L(tonight.title, lang)}</span>
          <span class="mt-2 inline-flex items-center gap-1.5 self-start font-bold text-prairie group-hover:text-prairie-deep">
            {d.recipes.tonightCta}
            <svg class="transition-transform group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </span>
        </span>
      </a>
    </div>
    <TornEdge position="bottom" variant="wave" height={28} class="edge-in text-paper" />
  </section>

  <section class="relative overflow-clip bg-paper pt-12 pb-24 sm:pt-14">
    <Deco type="coriandre" class="deco deco-lg start-0 bottom-1 hidden w-16 rotate-6 text-prairie/20 lg:block lg:w-20" />
    <div class="container-x">
      {/* Filtres : affichés seulement si le script tourne. */}
      <div class="filters reveal rounded-lg bg-cream p-4 sm:p-5" data-filters>
        <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-8">
          <div class="flex flex-wrap items-center gap-2">
            <span class="eyebrow me-1">{d.recipes.filterTime}</span>
            {
              timeFilters.map((f) => (
                <button type="button" class="filter-chip" data-filter="time" data-value={f.value} aria-pressed={f.value === 'all' ? 'true' : 'false'}>
                  {f.label}
                </button>
              ))
            }
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="eyebrow me-1">{d.recipes.filterDifficulty}</span>
            {
              diffFilters.map((f) => (
                <button type="button" class="filter-chip" data-filter="diff" data-value={f.value} aria-pressed={f.value === 'all' ? 'true' : 'false'}>
                  {f.label}
                </button>
              ))
            }
          </div>
        </div>
        <p class="mt-3 text-sm font-semibold text-ink-3" data-count data-one={d.recipes.filterCount(1)} data-many={d.recipes.filterCount(2)} aria-live="polite">{d.recipes.filterCount(seedRecipes.length)}</p>
      </div>

      <ul class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4" data-grid>
        {
          seedRecipes.map((r, i) => (
            <li data-card data-min={r.duration_min} data-diff={r.difficulty}>
              <RecipeCard recipe={r} lang={lang} index={i} eager={i < 2} />
            </li>
          ))
        }
      </ul>

      <div class="empty mt-8 hidden rounded-lg bg-cream p-8 text-center" data-empty>
        <p class="text-lg font-bold">{d.recipes.filterNone}</p>
        <button type="button" class="btn-soft mt-4 bg-paper" data-reset>{d.recipes.filterReset}</button>
      </div>
    </div>
    <TornEdge position="bottom" variant="torn" height={26} class="edge-in text-cream" />
  </section>

  <script>
    // Filtre des recettes : temps et difficulté. Les valeurs vivent sur les
    // cartes (data-min, data-diff), le reste n'est que de l'affichage. Sans
    // ce script, la barre reste cachée et toutes les recettes s'affichent.
    function setupFilters() {
      document.querySelectorAll<HTMLElement>('[data-filters]:not([data-live])').forEach((bar) => {
        bar.dataset.live = '1';
        const root = bar.parentElement;
        if (!root) return;
        const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
        const empty = root.querySelector<HTMLElement>('[data-empty]');
        const count = bar.querySelector<HTMLElement>('[data-count]');
        const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('.filter-chip'));
        const state = { time: 'all', diff: 'all' };

        // « 1 recette » et « 2 recettes » viennent du dictionnaire : on n'y
        // remplace que le chiffre, l'accord reste écrit dans la langue.
        const say = (n: number) => {
          const one = count?.dataset.one ?? '';
          const many = count?.dataset.many ?? '';
          return n <= 1 ? one.replace('1', String(n)) : many.replace('2', String(n));
        };

        const apply = () => {
          let shown = 0;
          cards.forEach((card) => {
            const min = Number(card.dataset.min ?? '0');
            const diff = card.dataset.diff ?? '';
            const okTime = state.time === 'all' || (state.time === 'long' ? min > 60 : min < Number(state.time));
            const okDiff = state.diff === 'all' || state.diff === diff;
            const ok = okTime && okDiff;
            card.hidden = !ok;
            if (ok) shown++;
          });
          if (empty) empty.classList.toggle('hidden', shown > 0);
          if (count) count.textContent = say(shown);
          chips.forEach((c) => {
            const group = c.dataset.filter as 'time' | 'diff';
            c.setAttribute('aria-pressed', String(state[group] === c.dataset.value));
          });
        };

        chips.forEach((chip) =>
          chip.addEventListener('click', () => {
            const group = chip.dataset.filter as 'time' | 'diff';
            state[group] = chip.dataset.value ?? 'all';
            apply();
          }),
        );
        root.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
          state.time = 'all';
          state.diff = 'all';
          apply();
          bar.scrollIntoView({ block: 'nearest', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        });
        apply();
      });
    }
    setupFilters();
    document.addEventListener('astro:page-load', setupFilters);
  </script>
</Base>

<style>
  /* La barre de filtres n'apparaît que si le script l'a prise en main. */
  .filters {
    display: none;
  }
  .filters[data-live] {
    display: block;
  }
  .filter-chip {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-line);
    background: var(--color-paper);
    padding: 0 0.95rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink-2);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .filter-chip:hover {
    border-color: color-mix(in oklab, var(--color-prairie) 50%, transparent);
  }
  .filter-chip[aria-pressed='true'] {
    border-color: var(--color-prairie);
    background: var(--color-prairie);
    color: var(--color-paper);
  }
  .tonight-photo {
    transform: rotate(-1deg);
    transition: transform 0.5s var(--ease-out-expo);
  }
  .tonight:hover .tonight-photo {
    transform: rotate(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .filter-chip,
    .tonight-photo {
      transition: none;
    }
  }
</style>
