# Copier en .env à la racine. Sans ces clés, le site et l'espace de gestion tournent en mode démo.
# Boutique (Astro lit les variables PUBLIC_*)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Espace de gestion (Vite lit les variables VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Chemin de base : /ferme-korba sur GitHub Pages, vide sur un domaine dédié.
BASE_PATH=
SITE_URL=
